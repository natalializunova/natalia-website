---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ContentCard from '../../components/ui/ContentCard.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Блог" description="Авторские материалы проекта о самопознании, внутренней опоре и четырёх Стихиях." noindex>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Блог' }]} />
  <PageHero eyebrow="Материалы" title="Блог" description="Будущее пространство статей, заметок и новостей. Демонстрационный материал помечен как черновик." />
  <section class="section"><div class="container"><div class="grid grid--3">{posts.map((post) => <ContentCard href={`/blog/${post.id}/`} title={post.data.title} summary={post.data.description} image={post.data.image} imageAlt={post.data.imageAlt} meta={post.data.draft ? `Черновик · ${post.data.category}` : post.data.category} />)}</div></div></section>
</BaseLayout>
