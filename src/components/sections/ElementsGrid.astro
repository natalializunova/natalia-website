---
import { Image } from 'astro:assets';
import earthImage from '../../assets/images/elements/earth.avif';
import waterImage from '../../assets/images/elements/water.avif';
import fireImage from '../../assets/images/elements/fire.avif';
import airImage from '../../assets/images/elements/air.avif';
import { elements } from '../../data/elements';

const images = { earth: earthImage, water: waterImage, fire: fireImage, air: airImage };
---

<div class="elements-visual" aria-label="Четыре Стихии">
  <div class="elements-visual__grid">
    {elements.map((element) => (
      <figure class:list={['element-visual', `element-visual--${element.key}`]} aria-label={element.name}>
        <Image
          src={images[element.key]}
          alt={element.imageAlt}
          widths={[320, 480, 640]}
          sizes="(min-width: 64rem) 25vw, (min-width: 36rem) 50vw, 100vw"
          format="webp"
          loading="lazy"
        />
        <span class="element-visual__atmosphere" aria-hidden="true"></span>
      </figure>
    ))}
  </div>

  <svg class="elements-visual__mark" viewBox="0 0 120 106" aria-hidden="true">
    <path d="M60 7 113 99H7Z" />
    <circle cx="60" cy="69" r="7" />
  </svg>
</div>

<style>
  .elements-visual {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgb(181 154 101 / 24%);
    background: #09090a;
    box-shadow: inset 0 0 5rem rgb(0 0 0 / 42%), 0 2rem 5rem rgb(0 0 0 / 18%);
  }

  .elements-visual::before {
    position: absolute;
    inset: 0.75rem;
    z-index: 4;
    border: 1px solid rgb(181 154 101 / 11%);
    content: '';
    pointer-events: none;
  }

  .elements-visual__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }

  .element-visual {
    position: relative;
    min-height: clamp(14rem, 42vw, 24rem);
    margin: 0;
    overflow: hidden;
    background: var(--color-black);
  }

  .element-visual:nth-child(odd) { border-right: 1px solid rgb(181 154 101 / 12%); }
  .element-visual:nth-child(-n + 2) { border-bottom: 1px solid rgb(181 154 101 / 12%); }

  .element-visual::after {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgb(7 7 8 / 10%), transparent 44%, rgb(7 7 8 / 46%));
    content: '';
    pointer-events: none;
  }

  .element-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.06) brightness(0.78);
    transform: scale(1.08);
  }

  .element-visual__atmosphere { position: absolute; inset: -14%; z-index: 1; overflow: hidden; pointer-events: none; }
  .element-visual__atmosphere::before, .element-visual__atmosphere::after { position: absolute; content: ''; }

  .element-visual--earth :global(img) { animation: earth-breathe 10s ease-in-out infinite alternate; }
  .element-visual--earth .element-visual__atmosphere { background: radial-gradient(circle at 68% 26%, rgb(216 184 108 / 26%), transparent 36%); animation: earth-light 7s ease-in-out infinite alternate; }

  .element-visual--water :global(img) { animation: water-flow 5.4s ease-in-out infinite alternate; }
  .element-visual--water .element-visual__atmosphere { background: linear-gradient(112deg, transparent 18%, rgb(197 221 229 / 20%) 48%, transparent 76%); mix-blend-mode: screen; animation: water-shimmer 3.8s ease-in-out infinite alternate; }
  .element-visual--water .element-visual__atmosphere::before,
  .element-visual--water .element-visual__atmosphere::after { right: 4%; bottom: 12%; left: 4%; height: 36%; border: 1px solid rgb(196 222 230 / 30%); border-radius: 50%; transform: scaleX(0.44); animation: water-ripple 4.2s ease-out infinite; }
  .element-visual--water .element-visual__atmosphere::after { animation-delay: -2.1s; }

  .element-visual--fire :global(img) { animation: fire-flicker 2.8s ease-in-out infinite; }
  .element-visual--fire .element-visual__atmosphere { background: radial-gradient(ellipse at 50% 66%, rgb(255 143 53 / 32%), transparent 52%); mix-blend-mode: screen; animation: fire-glow 2.1s ease-in-out infinite alternate; }

  .element-visual--air :global(img) { animation: air-drift 7s ease-in-out infinite alternate; }
  .element-visual--air .element-visual__atmosphere { background: linear-gradient(100deg, transparent 8%, rgb(236 235 226 / 22%) 40%, transparent 68%); mix-blend-mode: screen; animation: air-mist 5.4s ease-in-out infinite alternate; }
  .element-visual--air .element-visual__atmosphere::before,
  .element-visual--air .element-visual__atmosphere::after { right: -16%; left: -18%; height: 4rem; border-top: 1px solid rgb(238 237 229 / 36%); border-radius: 50%; filter: blur(0.12rem); animation: air-current 4.8s ease-in-out infinite alternate; }
  .element-visual--air .element-visual__atmosphere::before { top: 28%; }
  .element-visual--air .element-visual__atmosphere::after { top: 54%; opacity: 0.58; animation-delay: -2.2s; animation-duration: 6.4s; }

  .elements-visual__mark {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 5;
    width: clamp(4.75rem, 10vw, 7.5rem);
    overflow: visible;
    color: rgb(216 184 108 / 86%);
    filter: drop-shadow(0 0 1.4rem rgb(216 184 108 / 34%));
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .elements-visual__mark path, .elements-visual__mark circle { fill: rgb(9 9 10 / 62%); stroke: currentColor; stroke-width: 1.2; vector-effect: non-scaling-stroke; }

  @keyframes earth-breathe { from { filter: saturate(0.72) brightness(0.74); transform: scale(1.08); } to { filter: saturate(0.9) brightness(0.9); transform: scale(1.13) translateY(-0.6%); } }
  @keyframes earth-light { from { opacity: 0.28; transform: translate3d(-4%, 2%, 0) scale(0.96); } to { opacity: 0.74; transform: translate3d(4%, -2%, 0) scale(1.06); } }
  @keyframes water-flow { from { filter: brightness(0.74) contrast(1.02); transform: scale(1.16) translate3d(-2.6%, 0.8%, 0); } to { filter: brightness(0.96) contrast(1.12); transform: scale(1.22) translate3d(2.6%, -0.8%, 0); } }
  @keyframes water-shimmer { from { opacity: 0.22; transform: translateX(-12%) skewX(-5deg); } to { opacity: 0.72; transform: translateX(12%) skewX(5deg); } }
  @keyframes water-ripple { 0% { opacity: 0; transform: scaleX(0.3) scaleY(0.52); } 38% { opacity: 0.72; } 100% { opacity: 0; transform: scaleX(1.08) scaleY(1.12); } }
  @keyframes fire-flicker { 0%, 100% { filter: brightness(0.78) saturate(0.82); transform: scale(1.08); } 38% { filter: brightness(1.08) saturate(1.08); transform: scale(1.14) translateY(-1.2%); } 68% { filter: brightness(0.91) saturate(0.94); transform: scale(1.11) translateX(0.7%); } }
  @keyframes fire-glow { from { opacity: 0.3; transform: scale(0.92); } to { opacity: 0.84; transform: scale(1.12); } }
  @keyframes air-drift { from { filter: brightness(0.76) contrast(0.96); transform: scale(1.16) translateX(-3.2%); } to { filter: brightness(0.98) contrast(1.04); transform: scale(1.22) translateX(3.2%); } }
  @keyframes air-mist { from { opacity: 0.2; transform: translateX(-14%); } to { opacity: 0.68; transform: translateX(14%); } }
  @keyframes air-current { from { opacity: 0.16; transform: translateX(-18%) skewX(-5deg); } to { opacity: 0.76; transform: translateX(18%) skewX(5deg); } }

  @media (min-width: 64rem) {
    .elements-visual__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .element-visual { min-height: clamp(20rem, 29vw, 28rem); }
    .element-visual:nth-child(n) { border-top: 0; border-bottom: 0; border-right: 1px solid rgb(181 154 101 / 12%); }
    .element-visual:last-child { border-right: 0; }
  }

  @media (max-width: 35rem) { .element-visual { min-height: 13rem; } }

  @media (prefers-reduced-motion: reduce) {
    .element-visual :global(img),
    .element-visual__atmosphere,
    .element-visual__atmosphere::before,
    .element-visual__atmosphere::after { animation: none !important; }
  }
</style>
