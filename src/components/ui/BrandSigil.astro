---
type Props = {
  src?: string | null;
  alt?: string;
};

const { src, alt = '' } = Astro.props;
---

<span class="brand-sigil" aria-hidden={src ? undefined : 'true'}>
  {src ? (
    <img src={src} alt={alt} width="96" height="96" />
  ) : (
    <span class="brand-sigil__fallback">✦</span>
  )}
</span>

<style>
  .brand-sigil {
    display: grid;
    width: clamp(2.45rem, 4vw, 3rem);
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(181 154 101 / 34%);
    border-radius: 50%;
    background: radial-gradient(circle, rgb(181 154 101 / 10%), transparent 68%);
    color: var(--color-gold);
    filter: drop-shadow(0 0 0.7rem rgb(181 154 101 / 12%));
  }

  img { width: 84%; height: 84%; object-fit: contain; }
  .brand-sigil__fallback { font-size: 1.05rem; line-height: 1; }
</style>
