---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="Страница не найдена" description="Запрошенная страница не найдена." noindex>
  <section class="section"><div class="narrow stack"><p class="eyebrow">Ошибка 404</p><h1>Эта тропа пока не проложена</h1><p class="lead">Возможно, адрес изменился или страница ещё не создана.</p><div class="button-row"><Button href="/">Вернуться на главную</Button><Button href="/blog/" variant="ghost">Перейти в блог</Button></div></div></section>
</BaseLayout>
