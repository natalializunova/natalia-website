---
import type { Course } from '../../data/courses';
import Button from '../ui/Button.astro';
import AuthorSigil from '../ui/AuthorSigil.astro';
import CourseAtmosphereMedia from '../ui/CourseAtmosphereMedia.astro';
import CourseInquiryForm from './CourseInquiryForm.astro';
import mirrorImage from '../../assets/images/course/black-mirror-woman.png';
import philosophyImage from '../../assets/images/course/inner-path.png';
import elementsImage from '../../assets/images/course/living-elements.png';
import candleImage from '../../assets/images/course/candle-magic.png';
import protectionImage from '../../assets/images/course/protection-circle.png';
import placeOfPowerImage from '../../assets/images/course/place-of-power.png';

interface Props {
  course: Course;
}

const { course } = Astro.props;
const audience = course.faq[0];
const practices = course.faq[1]?.practices ?? [];
const practiceVisuals = [
  { src: elementsImage, alt: 'Живой природный алтарь четырёх Стихий', variant: 'nature' as const, position: 'center' },
  { src: candleImage, alt: 'Свечи для практики свечной магии', variant: 'candle' as const, position: 'center' },
  { src: protectionImage, alt: 'Сакральный круг энергетической защиты', variant: 'protection' as const, position: 'center' },
  { src: placeOfPowerImage, alt: 'Уединённое горное место Силы', variant: 'sanctuary' as const, position: 'center' },
];
---

<section class="course-hero" aria-labelledby="course-title">
  <div class="container course-hero__grid">
    <div class="course-hero__copy">
      <p class="eyebrow">Авторский курс</p>
      <h1 id="course-title">{course.title}</h1>
      <p class="course-hero__lead">{course.summary}</p>
      <div class="button-row">
        <Button href="#course-inquiry">Хочу пройти курс</Button>
        <Button href="#course-program" variant="ghost">Узнать о программе</Button>
      </div>
      <p class="course-hero__note">Путь начинается с импульса, узнавания и действия — в собственном темпе, без готовых схем.</p>
    </div>
    <div class="course-hero__visual">
      <CourseAtmosphereMedia
        src={mirrorImage}
        alt="Женщина смотрит в древнее чёрное зеркало"
        variant="mirror"
        position="center 42%"
        eager={true}
      />
    </div>
  </div>
</section>

<section class="section course-philosophy" id="course-program" aria-labelledby="course-philosophy-title">
  <div class="container course-philosophy__grid">
    <div class="course-philosophy__heading">
      <p class="eyebrow">Философия курса</p>
      <h2 id="course-philosophy-title">Магия как состояние и способ видеть</h2>
      <div class="course-philosophy__visual">
        <CourseAtmosphereMedia
          src={philosophyImage}
          alt="Внутренний путь к свету и собственному знанию"
          variant="journey"
          position="center"
        />
      </div>
    </div>
    <div class="course-philosophy__copy">
      <p>{course.authorParagraphs[2]}</p>
      <p>{course.authorParagraphs[4]}</p>
      <blockquote>
        <span aria-hidden="true">“</span>
        <p>Магия — это умение увидеть свое бытие. Это касание материи Духом.</p>
      </blockquote>
      <p>{course.authorParagraphs[5]}</p>
    </div>
  </div>
</section>

<section class="section course-practices" aria-labelledby="course-practices-title">
  <div class="container">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Практики курса</p>
        <h2 id="course-practices-title">Четыре направления работы</h2>
      </div>
      <p class="lead">Практики выстроены вокруг Стихий, огня, личных границ и собственного места Силы.</p>
    </div>

    <div class="course-practices__grid">
      {practices.map((practice, index) => (
        <article class="course-practice">
          <div class="course-practice__visual">
            <CourseAtmosphereMedia
              src={practiceVisuals[index].src}
              alt={practiceVisuals[index].alt}
              variant={practiceVisuals[index].variant}
              position={practiceVisuals[index].position}
              eager={true}
            />
            <span class="course-practice__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="course-practice__copy">
            <h3>{practice.title.replace(/\.$/, '')}</h3>
            <p>{practice.description}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="course-outcomes">
      <div>
        <p class="eyebrow">В результате</p>
        <h2>Пройдя курс, вы научитесь:</h2>
      </div>
      <div>
        <ul>{course.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
        <p class="course-outcomes__result">{course.result}</p>
      </div>
    </div>
  </div>
</section>

<section class="section course-audience" aria-labelledby="course-audience-title">
  <div class="container course-audience__grid">
    <div class="course-audience__intro">
      <p class="eyebrow">Для кого этот курс</p>
      <h2 id="course-audience-title">Когда прежний сценарий больше не подходит</h2>
      <div class="course-audience__themes" aria-label="Ключевые темы">
        <span>Поиск своего пути</span>
        <span>Потребность в переменах</span>
        <span>Понимание себя</span>
        <span>Внутренняя целостность</span>
      </div>
    </div>
    <div class="course-audience__copy">
      {audience.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<section class="section course-author" aria-labelledby="course-author-title">
  <div class="container course-author__grid">
    <div class="course-author__emblem" aria-hidden="true">
      <AuthorSigil width="clamp(12rem, 26vw, 20rem)" animationEnabled={true} variant="radiant" alt="" />
      <span class="course-author__orbit"></span>
    </div>
    <div class="course-author__copy">
      <p class="eyebrow">Авторский подход</p>
      <h2 id="course-author-title">Опыт, пропущенный через себя</h2>
      <p>{course.authorParagraphs[0]}</p>
      <p>{course.authorParagraphs[1]}</p>
      <blockquote>«В магии нет волшебной таблетки»</blockquote>
      <p>{course.authorParagraphs[3]}</p>
    </div>
  </div>
</section>

<section class="section course-faq" aria-labelledby="course-faq-title">
  <div class="narrow">
    <div class="section-heading">
      <p class="eyebrow">Подробнее о программе</p>
      <h2 id="course-faq-title">Вопросы о курсе</h2>
    </div>
    <div class="course-faq__list">
      {course.faq.map((item, index) => (
        <details class="course-faq__item" name="course-faq">
          <summary>
            <span class="course-faq__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span>{item.question}</span>
            <span class="course-faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="course-faq__answer">
            {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {item.intro && <p>{item.intro}</p>}
            {item.practices && (
              <ul>{item.practices.map((practice) => <li><strong>{practice.title}</strong> {practice.description}</li>)}</ul>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section course-inquiry" id="course-inquiry" aria-labelledby="course-inquiry-title">
  <div class="container course-inquiry__grid">
    <div class="course-inquiry__copy">
      <p class="eyebrow">Сделать первый шаг</p>
      <h2 id="course-inquiry-title">Готовы сделать первый шаг к своей Силе?</h2>
      <p>Если вы хотите узнать больше об авторском курсе или принять участие, оставьте заявку. Мы свяжемся с вами и расскажем подробнее.</p>
      <div class="button-row">
        <Button href="#course-form">Хочу участвовать в курсе</Button>
        <Button href="#course-form" variant="ghost">Задать вопрос о курсе</Button>
      </div>
      <p class="course-inquiry__philosophy">{course.closingParagraphs[0]}</p>
      <p class="course-inquiry__invitation">{course.closingParagraphs[1]}</p>
      <p class="course-inquiry__signature">{course.closingParagraphs[2]}</p>
    </div>
    <div class="course-inquiry__form">
      <CourseInquiryForm />
    </div>
  </div>
</section>

<style>
  .course-hero { position: relative; overflow: hidden; padding-block: var(--hero-top-space) clamp(4rem, 7vw, 6.5rem); background: radial-gradient(circle at 18% 18%, rgb(84 35 47 / 30%), transparent 30rem), radial-gradient(circle at 82% 48%, rgb(181 154 101 / 7%), transparent 32rem), linear-gradient(115deg, rgb(7 6 8 / 98%), rgb(17 14 17 / 94%)); }
  .course-hero::before { position: absolute; right: var(--page-gutter); bottom: 0; left: var(--page-gutter); height: 1px; background: linear-gradient(90deg, transparent, rgb(181 154 101 / 42%), transparent); content: ''; pointer-events: none; }
  .course-hero__grid { position: relative; display: grid; gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  .course-hero__copy { z-index: 1; }
  .course-hero h1 { max-width: 10ch; font-size: clamp(4rem, 7.5vw, 7rem); }
  .course-hero__lead { max-width: 38rem; margin-top: 1.5rem; color: var(--color-sand); font-family: var(--font-display); font-size: clamp(1.35rem, 2.6vw, 2.1rem); line-height: 1.42; }
  .course-hero__note { max-width: 36rem; margin-top: 1.25rem; color: var(--color-muted); line-height: 1.75; }
  .course-hero__visual { position: relative; min-height: clamp(30rem, 66vw, 45rem); overflow: hidden; border: 1px solid rgb(181 154 101 / 18%); border-radius: 48% 48% 1rem 1rem / 16% 16% 1rem 1rem; background: rgb(5 5 6 / 92%); box-shadow: 0 2.5rem 7rem rgb(0 0 0 / 48%), 0 0 3rem rgb(84 35 47 / 12%); }
  .course-hero__visual :global(.course-media) { height: 100%; min-height: inherit; }

  .course-philosophy,
  .course-practices,
  .course-audience,
  .course-author,
  .course-faq,
  .course-inquiry { border: 0; }
  .course-philosophy { background: radial-gradient(circle at 88% 26%, rgb(84 35 47 / 18%), transparent 28rem), linear-gradient(180deg, transparent, rgb(24 20 22 / 40%), transparent); }
  .course-philosophy__grid { display: grid; gap: clamp(2.5rem, 7vw, 7rem); }
  .course-philosophy__heading { align-self: start; }
  .course-philosophy__heading h2 { max-width: 12ch; }
  .course-philosophy__visual { min-height: clamp(20rem, 36vw, 28rem); margin-top: 2.5rem; overflow: hidden; border: 1px solid rgb(181 154 101 / 22%); border-radius: 48% 48% 0.8rem 0.8rem / 18% 18% 0.8rem 0.8rem; box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 26%); }
  .course-philosophy__visual :global(.course-media) { min-height: inherit; }
  .course-philosophy__copy { display: grid; gap: 1.5rem; color: var(--color-muted); line-height: 1.86; }
  .course-philosophy__copy p { white-space: pre-line; }
  .course-philosophy blockquote { position: relative; margin: 1.2rem 0; padding: clamp(1.5rem, 4vw, 2.6rem) 0 clamp(1.5rem, 4vw, 2.6rem) clamp(3rem, 6vw, 5rem); border: 0; background: transparent; }
  .course-philosophy blockquote::before { position: absolute; top: 50%; left: 0; width: clamp(2rem, 4vw, 3.75rem); height: 1px; background: linear-gradient(90deg, var(--color-gold-muted), transparent); content: ''; }
  .course-philosophy blockquote > span { display: none; }
  .course-philosophy blockquote p { position: relative; color: var(--color-sand); font-family: var(--font-display); font-size: clamp(1.45rem, 3vw, 2.3rem); font-style: italic; line-height: 1.4; }

  .course-practices { background: radial-gradient(circle at 70% 24%, rgb(181 154 101 / 6%), transparent 34rem), linear-gradient(180deg, rgb(17 15 17 / 48%), rgb(28 25 27 / 64%) 50%, rgb(16 15 17 / 46%)); }
  .course-practices__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  .course-practice { display: grid; grid-template-rows: auto 1fr; overflow: hidden; border: 1px solid rgb(181 154 101 / 16%); border-radius: 1rem; background: linear-gradient(155deg, rgb(31 27 29 / 94%), rgb(14 13 15 / 98%)); box-shadow: 0 1.5rem 3.5rem rgb(0 0 0 / 16%); }
  .course-practice__visual { position: relative; min-height: 19rem; margin: 0.65rem 0.65rem 0; overflow: hidden; border-radius: 48% 48% 0.35rem 0.35rem / 18% 18% 0.35rem 0.35rem; background: var(--color-black); }
  .course-practice__visual :global(.course-media) { min-height: inherit; }
  .course-practice__number { position: absolute; top: 1.25rem; left: 1.25rem; z-index: 2; color: var(--color-gold); font-size: var(--text-xs); letter-spacing: 0.14em; }
  .course-practice__copy { display: grid; gap: 0.9rem; align-content: start; padding: clamp(1.5rem, 4vw, 2.5rem); }
  .course-practice__copy p { color: var(--color-muted); line-height: 1.75; }
  .course-outcomes { display: grid; gap: clamp(2rem, 6vw, 5rem); margin-top: var(--section-space); padding: clamp(1.5rem, 5vw, 3.5rem); border: 1px solid rgb(181 154 101 / 18%); border-radius: 1rem; background: linear-gradient(135deg, rgb(181 154 101 / 8%), transparent 42%), rgb(9 9 10 / 58%); box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 18%); }
  .course-outcomes ul { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .course-outcomes li { position: relative; padding-left: 1.5rem; color: var(--color-text); line-height: 1.72; }
  .course-outcomes li::before { position: absolute; top: 0.65em; left: 0; width: 0.42rem; height: 0.42rem; border: 1px solid var(--color-gold); content: ''; transform: rotate(45deg); }
  .course-outcomes__result { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); color: var(--color-sand); font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.6; }

  .course-audience { background: radial-gradient(circle at 15% 55%, rgb(149 90 67 / 14%), transparent 32rem), linear-gradient(180deg, rgb(20 18 20 / 40%), rgb(28 25 27 / 58%), rgb(17 15 17 / 42%)); }
  .course-audience__grid { display: grid; gap: clamp(2.5rem, 7vw, 7rem); }
  .course-audience__intro h2 { max-width: 13ch; }
  .course-audience__themes { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 2rem; }
  .course-audience__themes span { padding: 0.55rem 0.8rem; border: 1px solid rgb(181 154 101 / 28%); color: var(--color-sand); font-size: var(--text-xs); letter-spacing: 0.06em; }
  .course-audience__copy { display: grid; gap: 1.35rem; align-content: center; color: var(--color-muted); line-height: 1.86; }
  .course-audience__copy p:first-child { color: var(--color-text); font-family: var(--font-display); font-size: var(--text-lg); }

  .course-author { overflow: hidden; background: radial-gradient(circle at 25% 48%, rgb(84 35 47 / 14%), transparent 30rem); }
  .course-author__grid { display: grid; gap: clamp(2.5rem, 7vw, 7rem); align-items: center; }
  .course-author__emblem { position: relative; display: grid; min-height: 25rem; place-items: center; background: radial-gradient(circle, rgb(84 35 47 / 26%), transparent 60%); }
  .course-author__orbit { position: absolute; width: min(85%, 25rem); aspect-ratio: 1; border: 1px solid rgb(181 154 101 / 20%); border-radius: 50%; }
  .course-author__orbit::before,
  .course-author__orbit::after { position: absolute; inset: 11%; border: 1px solid rgb(181 154 101 / 12%); content: ''; transform: rotate(45deg); }
  .course-author__orbit::after { transform: rotate(67.5deg); }
  .course-author__copy { display: grid; gap: 1.25rem; color: var(--color-muted); line-height: 1.82; }
  .course-author__copy blockquote { margin: 0.75rem 0; color: var(--color-gold-bright); font-family: var(--font-display); font-size: clamp(1.7rem, 4vw, 3.2rem); line-height: 1.2; }

  .course-faq { background: linear-gradient(180deg, rgb(18 16 18 / 44%), rgb(29 27 28 / 66%), rgb(17 15 17 / 44%)); }
  .course-faq__list { border-top: 1px solid var(--color-border); }
  .course-faq__item { border-bottom: 1px solid var(--color-border); }
  .course-faq__item summary { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; padding-block: 1.5rem; cursor: pointer; font-family: var(--font-display); font-size: clamp(1.15rem, 2vw, 1.5rem); list-style: none; }
  .course-faq__item summary::-webkit-details-marker { display: none; }
  .course-faq__number { color: var(--color-gold-muted); font-family: var(--font-body); font-size: var(--text-xs); letter-spacing: 0.14em; }
  .course-faq__icon { position: relative; width: 1rem; height: 1rem; color: var(--color-gold); }
  .course-faq__icon::before,
  .course-faq__icon::after { position: absolute; top: 50%; left: 50%; width: 100%; height: 1px; background: currentColor; content: ''; transform: translate(-50%, -50%); transition: transform var(--transition), opacity var(--transition); }
  .course-faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .course-faq__item[open] .course-faq__icon::after { opacity: 0; transform: translate(-50%, -50%) rotate(0); }
  .course-faq__item[open] summary { color: var(--color-gold-bright); }
  .course-faq__answer { display: grid; gap: 1rem; max-width: 52rem; padding: 0 0 1.75rem clamp(2rem, 5vw, 3rem); color: var(--color-muted); line-height: 1.78; animation: faq-reveal 220ms ease-out; }
  .course-faq__answer ul { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .course-faq__answer li { padding-left: 1rem; border-left: 1px solid var(--color-gold-muted); }
  .course-faq__answer strong { color: var(--color-gold-bright); font-weight: 600; }

  .course-inquiry { background: radial-gradient(circle at 18% 12%, rgb(84 35 47 / 32%), transparent 30rem), linear-gradient(120deg, var(--color-black), var(--color-surface-soft)); }
  .course-inquiry__grid { display: grid; gap: clamp(2.5rem, 7vw, 7rem); align-items: start; }
  .course-inquiry__copy { display: grid; gap: 1.25rem; color: var(--color-muted); line-height: 1.8; }
  .course-inquiry__copy h2 { max-width: 12ch; }
  .course-inquiry__philosophy { margin-top: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); color: var(--color-sand); font-family: var(--font-display); font-size: var(--text-lg); }
  .course-inquiry__invitation { color: var(--color-gold-bright); font-family: var(--font-display); font-size: var(--text-lg); }
  .course-inquiry__signature { color: var(--color-gold); font-family: var(--font-display); font-size: var(--text-lg); font-style: italic; }
  .course-inquiry__form { padding: clamp(1.25rem, 4vw, 2.5rem); border: 1px solid rgb(181 154 101 / 18%); border-radius: 1rem; background: linear-gradient(155deg, rgb(22 19 21 / 82%), rgb(8 8 9 / 78%)); box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 22%); }

  @keyframes faq-reveal { from { opacity: 0; transform: translateY(-0.35rem); } to { opacity: 1; transform: translateY(0); } }

  @media (min-width: 48rem) {
    .course-practices__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .course-outcomes { grid-template-columns: 0.8fr 1.2fr; }
  }

  @media (min-width: 64rem) {
    .course-hero__grid { grid-template-columns: minmax(0, 0.88fr) minmax(28rem, 1.12fr); }
    .course-philosophy__grid,
    .course-audience__grid,
    .course-author__grid,
    .course-inquiry__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .course-practice { min-height: 100%; }
  }

  @media (max-width: 41.99rem) {
    .course-hero h1 { font-size: clamp(3.7rem, 20vw, 5.4rem); }
    .course-hero__visual { margin-inline: -0.5rem; }
    .course-practice__visual { min-height: 16rem; }
    .course-faq__item summary { gap: 0.7rem; }
    .course-faq__answer { padding-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .course-faq__answer { animation: none; transition: none; }
  }
</style>
