---
import { Image } from 'astro:assets';
import earthImage from '../../assets/images/elements/earth.avif';
import waterImage from '../../assets/images/elements/water.avif';
import fireImage from '../../assets/images/elements/fire.avif';
import airImage from '../../assets/images/elements/air.avif';
import AlchemyGlyph from '../ui/AlchemyGlyph.astro';
import { elements } from '../../data/elements';

const images = { earth: earthImage, water: waterImage, fire: fireImage, air: airImage };
const initialElement = elements[0];
---

<div class="elements-experience" data-elements-root data-visible="false" data-active-element={initialElement.key}>
  <div class="element-cards" role="tablist" aria-label="Выберите стихию">
    {elements.map((element) => (
      <article
        class="element-card"
        data-element-card={element.key}
        data-element-name={element.name}
        data-active={element.key === initialElement.key ? 'true' : 'false'}
        data-motion="on"
      >
        <div class="element-card__visual">
          <Image
            src={images[element.key]}
            alt={element.imageAlt}
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 19rem, (min-width: 36rem) 50vw, 50vw"
            format="webp"
            loading="lazy"
          />
          <span class="element-card__effect" aria-hidden="true"></span>
        </div>

        <button
          class="element-card__select"
          type="button"
          role="tab"
          id={`element-tab-${element.key}`}
          aria-controls="element-panel"
          aria-selected={element.key === initialElement.key ? 'true' : 'false'}
          tabindex={element.key === initialElement.key ? 0 : -1}
          data-element-tab={element.key}
        >
          <span class="element-card__number">{element.number}</span>
          <span class="element-card__copy">
            <span class="element-card__name">{element.name}</span>
            <span class="element-card__subtitle">{element.subtitle}</span>
            <span class="element-card__traits" aria-hidden="true">{element.traits.join(' · ')}</span>
          </span>
        </button>

        <button
          class="element-motion"
          type="button"
          aria-pressed="true"
          aria-label={`Остановить движение стихии ${element.name}`}
          title={`Остановить движение стихии ${element.name}`}
          data-element-motion={element.key}
        >
          <span class="element-motion__pause" aria-hidden="true"></span>
          <span class="element-motion__play" aria-hidden="true"></span>
        </button>
      </article>
    ))}
  </div>

  <div class="element-bridge" aria-hidden="true"><span></span></div>

  <article
    class="element-panel"
    id="element-panel"
    role="tabpanel"
    aria-labelledby={`element-tab-${initialElement.key}`}
    aria-live="polite"
    data-active-element={initialElement.key}
    data-motion="on"
  >
    <div class="element-panel__backdrops" aria-hidden="true">
      {elements.map((element) => (
        <figure
          class="element-panel__backdrop"
          data-element-panel-visual={element.key}
          data-active={element.key === initialElement.key ? 'true' : 'false'}
        >
          <Image
            src={images[element.key]}
            alt=""
            widths={[640, 960]}
            sizes="(min-width: 58rem) 62rem, 100vw"
            format="webp"
            loading="lazy"
          />
        </figure>
      ))}
      <span class="element-panel__atmosphere"></span>
      <span class="element-panel__scrim"></span>
    </div>

    <header class="element-panel__header">
      <p class="element-panel__number" data-panel-number>{initialElement.number}</p>
      <div class="element-panel__intro">
        <p class="element-panel__subtitle" data-panel-subtitle>{initialElement.subtitle}</p>
        <h3 data-panel-title>{initialElement.title}</h3>
        <p class="element-panel__summary" data-panel-summary>{initialElement.summary}</p>
        <p class="element-panel__introduction" data-panel-introduction>{initialElement.introduction}</p>
      </div>
      <div class="element-panel__identity">
        <div class="element-panel__sigil-stage" aria-hidden="true">
          {elements.map((element) => (
            <span
              class="element-panel__sigil"
              data-panel-sigil={element.key}
              data-active={element.key === initialElement.key ? 'true' : 'false'}
            >
              <AlchemyGlyph element={element.key} />
            </span>
          ))}
        </div>
        <div class="element-panel__identity-copy">
          <p class="element-panel__element-name" data-panel-element-name>{initialElement.name}</p>
          <ul class="element-panel__traits" aria-label={`Качества стихии ${initialElement.name}`} data-panel-traits>
            {initialElement.traits.map((trait) => <li>{trait}</li>)}
          </ul>
        </div>
      </div>
    </header>

    <div class="element-panel__details">
      <section class="element-panel__section">
        <p class="element-panel__label">В гармонии <span>(плюсы)</span></p>
        <div class="element-panel__paragraphs" data-panel-harmony>
          {initialElement.harmony.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="element-panel__section">
        <p class="element-panel__label">В дисбалансе <span>(минусы)</span></p>
        <div class="element-panel__paragraphs" data-panel-imbalance>
          {initialElement.imbalance.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    </div>

    <div class="element-panel__archetypes">
      <p class="element-panel__label">Архетипы в поведении</p>
      <p data-panel-archetypes>{initialElement.archetypes}</p>
    </div>
  </article>
</div>

<script define:vars={{ elements }}>
  const root = document.querySelector('[data-elements-root]');

  if (root) {
    const tabs = [...root.querySelectorAll('[data-element-tab]')];
    const cards = [...root.querySelectorAll('[data-element-card]')];
    const motionButtons = [...root.querySelectorAll('[data-element-motion]')];
    const panelVisuals = [...root.querySelectorAll('[data-element-panel-visual]')];
    const panelSigils = [...root.querySelectorAll('[data-panel-sigil]')];
    const panel = root.querySelector('#element-panel');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const setText = (selector, value) => {
      const target = root.querySelector(selector);
      if (target) target.textContent = value;
    };

    const createParagraphs = (paragraphs) => paragraphs.map((text) => {
      const paragraph = document.createElement('p');
      paragraph.textContent = text;
      return paragraph;
    });

    const updatePanel = (element) => {
      panel.setAttribute('aria-labelledby', `element-tab-${element.key}`);
      setText('[data-panel-number]', element.number);
      setText('[data-panel-subtitle]', element.subtitle);
      setText('[data-panel-title]', element.title);
      setText('[data-panel-summary]', element.summary);
      setText('[data-panel-introduction]', element.introduction);
      setText('[data-panel-archetypes]', element.archetypes);
      setText('[data-panel-element-name]', element.name);

      const traitList = root.querySelector('[data-panel-traits]');
      traitList.setAttribute('aria-label', `Качества стихии ${element.name}`);
      traitList.replaceChildren(...element.traits.map((trait) => {
        const item = document.createElement('li');
        item.textContent = trait;
        return item;
      }));

      root.querySelector('[data-panel-harmony]').replaceChildren(...createParagraphs(element.harmony));
      root.querySelector('[data-panel-imbalance]').replaceChildren(...createParagraphs(element.imbalance));
    };

    let panelTransition;

    const selectElement = (key) => {
      const next = elements.find((element) => element.key === key);
      if (!next) return;
      const activeCard = cards.find((card) => card.dataset.elementCard === key);
      panelTransition?.cancel();

      tabs.forEach((tab) => {
        const selected = tab.dataset.elementTab === key;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      cards.forEach((card) => card.dataset.active = String(card.dataset.elementCard === key));
      panelVisuals.forEach((visual) => visual.dataset.active = String(visual.dataset.elementPanelVisual === key));
      panelSigils.forEach((sigil) => sigil.dataset.active = String(sigil.dataset.panelSigil === key));
      root.dataset.activeElement = key;
      panel.dataset.activeElement = key;
      panel.dataset.motion = activeCard?.dataset.motion ?? 'off';

      if (!reducedMotion.matches && panel.animate) {
        const previousHeight = panel.getBoundingClientRect().height;
        panel.style.height = `${previousHeight}px`;
        updatePanel(next);
        const nextHeight = panel.scrollHeight;
        panelTransition = panel.animate([
          { height: `${previousHeight}px`, opacity: 0.46 },
          { height: `${nextHeight}px`, opacity: 1 },
        ], { duration: 300, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
        panelTransition.onfinish = () => { panel.style.height = ''; panelTransition = undefined; };
        panelTransition.oncancel = () => { panel.style.height = ''; panelTransition = undefined; };
      } else {
        updatePanel(next);
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectElement(tab.dataset.elementTab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        tabs[nextIndex].focus();
        selectElement(tabs[nextIndex].dataset.elementTab);
      });
    });

    const setCardMotion = (card, button, enabled) => {
      const elementName = card.dataset.elementName;
      card.dataset.motion = enabled ? 'on' : 'off';
      button.setAttribute('aria-pressed', String(enabled));
      button.setAttribute('aria-label', `${enabled ? 'Остановить' : 'Включить'} движение стихии ${elementName}`);
      button.title = `${enabled ? 'Остановить' : 'Включить'} движение стихии ${elementName}`;
      if (card.dataset.active === 'true') panel.dataset.motion = enabled ? 'on' : 'off';
    };

    motionButtons.forEach((button) => {
      const card = root.querySelector(`[data-element-card="${button.dataset.elementMotion}"]`);
      button.addEventListener('click', () => setCardMotion(card, button, card.dataset.motion !== 'on'));
    });

    if (reducedMotion.matches) {
      motionButtons.forEach((button) => {
        const card = root.querySelector(`[data-element-card="${button.dataset.elementMotion}"]`);
        setCardMotion(card, button, false);
        button.disabled = true;
        button.title = 'Движение отключено системной настройкой';
      });
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        root.dataset.visible = String(entry.isIntersecting);
      }, { threshold: 0.12 });
      observer.observe(root);
    } else {
      root.dataset.visible = 'true';
    }
  }
</script>

<style>
  .elements-experience {
    --active-x: 12.5%;
    --active-accent: 181 154 101;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: linear-gradient(145deg, rgb(32 32 35 / 98%), rgb(14 14 16 / 99%));
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 16%);
  }

  .elements-experience[data-active-element='water'] { --active-x: 37.5%; --active-accent: 147 176 190; }
  .elements-experience[data-active-element='fire'] { --active-x: 62.5%; --active-accent: 216 119 59; }
  .elements-experience[data-active-element='air'] { --active-x: 87.5%; --active-accent: 202 200 192; }

  .element-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
  }

  .element-card {
    --card-accent: 181 154 101;
    position: relative;
    min-height: clamp(14rem, 22vw, 17.25rem);
    isolation: isolate;
    overflow: hidden;
    background: var(--color-black);
    opacity: 0.72;
    filter: saturate(0.74) brightness(0.8);
    transition: opacity 280ms ease, filter 280ms ease, transform 280ms ease;
  }

  .element-card[data-element-card='water'] { --card-accent: 147 176 190; }
  .element-card[data-element-card='fire'] { --card-accent: 216 119 59; }
  .element-card[data-element-card='air'] { --card-accent: 202 200 192; }

  .element-card::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 1px solid transparent;
    content: '';
    pointer-events: none;
    transition: border-color 240ms ease, box-shadow 240ms ease;
  }

  .element-card[data-active='true']::after {
    border-color: rgb(var(--card-accent) / 72%);
    border-bottom-color: rgb(var(--card-accent) / 18%);
    box-shadow: inset 0 0 0 1px rgb(var(--card-accent) / 18%), inset 0 -5rem 5.5rem rgb(var(--card-accent) / 13%), 0 0 1.8rem rgb(var(--card-accent) / 10%);
  }

  .element-card[data-active='true'] {
    z-index: 2;
    opacity: 1;
    filter: saturate(1.08) brightness(1.06);
    transform: translateY(-2px);
  }

  .element-card[data-active='true'] .element-card__name { text-shadow: 0 0 1.25rem rgb(var(--card-accent) / 45%); }
  .element-card[data-active='true'] .element-card__visual::after { background: linear-gradient(180deg, rgb(9 9 10 / 14%), rgb(9 9 10 / 10%) 30%, rgb(9 9 10 / 88%) 100%), radial-gradient(ellipse at 50% 104%, rgb(var(--card-accent) / 28%), transparent 58%); }

  .element-card__visual,
  .element-card__visual::before,
  .element-card__visual::after {
    position: absolute;
    inset: 0;
  }

  .element-card__effect { position: absolute; inset: 0; z-index: 2; overflow: hidden; pointer-events: none; }
  .element-card__effect::before, .element-card__effect::after { position: absolute; content: ''; }
  [data-element-card='earth'] .element-card__effect::before { right: 19%; bottom: 25%; width: 0.18rem; height: 2rem; border-radius: 100% 0; background: linear-gradient(var(--color-gold-bright), #5e6841); box-shadow: 0 0 0.8rem rgb(216 184 108 / 26%); transform: scaleY(0.55); transform-origin: 50% 100%; }
  [data-element-card='earth'] .element-card__effect::after { right: calc(19% - 0.65rem); bottom: calc(25% + 1.2rem); width: 1.35rem; height: 0.65rem; border-radius: 100% 0 100% 0; background: linear-gradient(135deg, #a89758, #39452c); transform: rotate(-13deg) scale(0.66); }
  [data-element-card='water'] .element-card__effect::before { right: 8%; bottom: 17%; left: 8%; height: 38%; border: 1px solid rgb(190 220 229 / 24%); border-radius: 50%; box-shadow: 0 0 0 0.6rem rgb(190 220 229 / 7%), 0 0 0 1.4rem rgb(190 220 229 / 4%); transform: scaleX(0.78); }
  [data-element-card='fire'] .element-card__effect::before { right: 8%; bottom: 8%; width: 0.25rem; height: 0.25rem; border-radius: 50%; background: #f7c36b; box-shadow: -2rem -2rem 0 #d97937, -4.2rem -0.8rem 0 #f1b45b, -6rem -3.5rem 0 #bd5d32, -8rem -1.2rem 0 #e2a04e; }
  [data-element-card='air'] .element-card__effect::before, [data-element-card='air'] .element-card__effect::after { right: -20%; left: -20%; height: 2.8rem; border-top: 1px solid rgb(238 231 220 / 25%); border-radius: 50%; filter: blur(0.12rem); }
  [data-element-card='air'] .element-card__effect::before { top: 27%; }
  [data-element-card='air'] .element-card__effect::after { top: 49%; opacity: 0.65; }

  .element-card__visual::before {
    z-index: 1;
    content: '';
    opacity: 0.55;
    pointer-events: none;
  }

  .element-card__visual::after {
    z-index: 2;
    background: linear-gradient(180deg, rgb(9 9 10 / 18%), rgb(9 9 10 / 12%) 32%, rgb(9 9 10 / 90%) 100%);
    content: '';
    pointer-events: none;
  }

  .element-card__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: filter 300ms ease;
  }

  .element-card__select {
    position: absolute;
    inset: 0;
    display: flex;
    z-index: 2;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1rem;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    text-align: left;
  }

  .element-card__select:focus-visible { outline: 2px solid var(--color-gold); outline-offset: -0.45rem; }
  .element-card__number { color: rgb(238 231 220 / 76%); font-family: var(--font-display); font-size: 1.45rem; line-height: 1; text-shadow: 0 2px 0.8rem rgb(0 0 0 / 70%); }
  .element-card__copy { display: grid; gap: 0.35rem; max-width: 17rem; }
  .element-card__name { color: var(--color-gold-bright); font-family: var(--font-display); font-size: clamp(1.55rem, 3vw, 2.15rem); line-height: 1; }
  .element-card__subtitle { color: var(--color-sand); font-size: 0.66rem; font-weight: 650; letter-spacing: 0.1em; line-height: 1.45; text-transform: uppercase; }
  .element-card__traits { color: var(--color-sand); font-size: 0.68rem; line-height: 1.45; }

  .element-motion {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    z-index: 4;
    place-items: center;
    padding: 0;
    border: 1px solid rgb(238 231 220 / 28%);
    border-radius: 50%;
    background: rgb(9 9 10 / 52%);
    color: var(--color-gold);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 180ms ease, border-color 180ms ease;
  }

  .element-motion:hover { border-color: var(--color-gold); background: rgb(9 9 10 / 78%); }
  .element-motion__pause { width: 0.38rem; height: 0.55rem; border-inline: 1px solid currentColor; }
  .element-motion__play { display: none; width: 0; height: 0; margin-left: 0.1rem; border-block: 0.32rem solid transparent; border-left: 0.48rem solid currentColor; }
  [data-motion='off'] .element-motion__pause { display: none; }
  [data-motion='off'] .element-motion__play { display: block; }
  .element-motion:disabled { cursor: default; opacity: 0.62; }

  .element-bridge {
    position: relative;
    height: clamp(2.2rem, 3vw, 2.8rem);
    z-index: 4;
    margin-top: -1.15rem;
    overflow: hidden;
    background: linear-gradient(180deg, transparent 0%, rgb(10 9 11 / 58%) 42%, rgb(13 12 14 / 96%) 100%);
    pointer-events: none;
  }

  .element-bridge::before {
    position: absolute;
    top: -1.3rem;
    left: var(--active-x);
    width: clamp(8rem, 23vw, 17rem);
    height: 4.6rem;
    background: radial-gradient(ellipse at 50% 0%, rgb(var(--active-accent) / 34%), rgb(var(--active-accent) / 12%) 36%, transparent 72%);
    content: '';
    filter: blur(0.55rem);
    opacity: 0.78;
    transform: translateX(-50%);
    transition: left 420ms cubic-bezier(0.22, 1, 0.36, 1), background 360ms ease;
  }

  .element-bridge > span {
    position: absolute;
    top: 1.05rem;
    left: var(--active-x);
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid rgb(var(--active-accent) / 76%);
    background: rgb(13 12 14 / 88%);
    box-shadow: 0 0 0.85rem rgb(var(--active-accent) / 32%);
    transform: translateX(-50%) rotate(45deg);
    transition: left 420ms cubic-bezier(0.22, 1, 0.36, 1), border-color 360ms ease, box-shadow 360ms ease;
  }

  .element-panel {
    --panel-accent: var(--active-accent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: -0.2rem;
    padding: clamp(1.75rem, 4.4vw, 3.6rem);
    background: rgb(13 12 14 / 94%);
    box-shadow: inset 0 0 6rem rgb(var(--panel-accent) / 7%);
    transition: box-shadow 320ms ease;
  }

  .element-panel::before {
    position: absolute;
    top: -6.5rem;
    left: var(--active-x);
    width: clamp(15rem, 32vw, 26rem);
    height: 11rem;
    z-index: 1;
    background: radial-gradient(ellipse at 50% 0%, rgb(var(--panel-accent) / 25%), rgb(var(--panel-accent) / 8%) 40%, transparent 72%);
    content: '';
    filter: blur(0.9rem);
    opacity: 0.82;
    pointer-events: none;
    transform: translateX(-50%);
    transition: left 420ms cubic-bezier(0.22, 1, 0.36, 1), background 360ms ease;
  }

  .element-panel__backdrops,
  .element-panel__backdrop,
  .element-panel__atmosphere,
  .element-panel__scrim { position: absolute; inset: 0; pointer-events: none; }

  .element-panel__backdrops { z-index: 0; overflow: hidden; }
  .element-panel__backdrop { margin: 0; opacity: 0; transition: opacity 420ms ease; }
  .element-panel__backdrop[data-active='true'] { opacity: 0.38; }
  .element-panel__backdrop :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.72) contrast(1.08); transform: scale(1.08); }

  .element-panel__atmosphere {
    z-index: 1;
    opacity: 0.6;
    mix-blend-mode: screen;
    transition: background 420ms ease, opacity 420ms ease;
  }

  .element-panel[data-active-element='earth'] .element-panel__atmosphere { background: radial-gradient(circle at 80% 10%, rgb(212 181 110 / 24%), transparent 36%), linear-gradient(120deg, rgb(71 68 37 / 20%), transparent 48%); }
  .element-panel[data-active-element='water'] .element-panel__atmosphere { background: repeating-radial-gradient(ellipse at 78% 18%, transparent 0 1.5rem, rgb(169 201 211 / 10%) 1.7rem 1.82rem, transparent 2.05rem 3.2rem), linear-gradient(105deg, transparent 15%, rgb(177 205 213 / 17%) 48%, transparent 76%); }
  .element-panel[data-active-element='fire'] .element-panel__atmosphere { background: radial-gradient(ellipse at 82% 28%, rgb(241 129 48 / 27%), transparent 42%), radial-gradient(circle at 18% 82%, rgb(153 47 31 / 17%), transparent 36%); }
  .element-panel[data-active-element='air'] .element-panel__atmosphere { background: linear-gradient(105deg, transparent 4%, rgb(230 228 218 / 15%) 36%, transparent 62%), radial-gradient(ellipse at 76% 14%, rgb(225 224 217 / 14%), transparent 46%); }

  .element-panel__scrim {
    z-index: 2;
    background: linear-gradient(90deg, rgb(10 9 11 / 94%) 0%, rgb(10 9 11 / 88%) 54%, rgb(10 9 11 / 66%) 100%), linear-gradient(180deg, rgb(10 9 11 / 34%), rgb(10 9 11 / 86%));
  }

  .element-panel__header,
  .element-panel__details,
  .element-panel__archetypes { position: relative; z-index: 3; }

  .element-panel__header { display: grid; align-items: start; gap: clamp(1.4rem, 3.2vw, 2.8rem); }
  .element-panel__number { color: var(--color-gold-muted); font-family: var(--font-display); font-size: clamp(2.8rem, 7vw, 5.25rem); line-height: 0.85; }
  .element-panel__subtitle { color: var(--color-gold); font-size: var(--text-xs); font-weight: 650; letter-spacing: 0.13em; line-height: 1.5; text-transform: uppercase; }
  .element-panel__intro h3 { max-width: 25ch; margin-top: 0.45rem; font-size: clamp(1.65rem, 3.2vw, 2.6rem); line-height: 1.12; }
  .element-panel__summary { max-width: 55rem; margin-top: 1.2rem; color: var(--color-text); font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.62; }
  .element-panel__introduction { max-width: 55rem; margin-top: 0.9rem; color: var(--color-muted); line-height: 1.76; }
