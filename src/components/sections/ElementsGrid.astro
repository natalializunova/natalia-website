---
import { Image } from 'astro:assets';
import earthImage from '../../assets/images/elements/earth.avif';
import waterImage from '../../assets/images/elements/water.avif';
import fireImage from '../../assets/images/elements/fire.avif';
import airImage from '../../assets/images/elements/air.avif';
import { elements } from '../../data/elements';

const images = { earth: earthImage, water: waterImage, fire: fireImage, air: airImage };
const initialElement = elements[0];
---

<div class="elements-experience" data-elements-root data-visible="false">
  <div class="element-cards" role="tablist" aria-label="Выберите стихию">
    {elements.map((element) => (
      <article
        class="element-card"
        data-element-card={element.key}
        data-element-name={element.name}
        data-active={element.key === initialElement.key ? 'true' : 'false'}
        data-motion="on"
      >
        <div class="element-card__visual">
          <Image
            src={images[element.key]}
            alt={element.imageAlt}
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 19rem, (min-width: 36rem) 50vw, 50vw"
            format="webp"
            loading="lazy"
          />
        </div>

        <button
          class="element-card__select"
          type="button"
          role="tab"
          id={`element-tab-${element.key}`}
          aria-controls="element-panel"
          aria-selected={element.key === initialElement.key ? 'true' : 'false'}
          tabindex={element.key === initialElement.key ? 0 : -1}
          data-element-tab={element.key}
        >
          <span class="element-card__number">{element.number}</span>
          <span class="element-card__copy">
            <span class="element-card__name">{element.name}</span>
            <span class="element-card__subtitle">{element.subtitle}</span>
            <span class="element-card__traits" aria-hidden="true">{element.traits.join(' · ')}</span>
          </span>
        </button>

        <button
          class="element-motion"
          type="button"
          aria-pressed="true"
          aria-label={`Остановить движение стихии ${element.name}`}
          title={`Остановить движение стихии ${element.name}`}
          data-element-motion={element.key}
        >
          <span class="element-motion__pause" aria-hidden="true"></span>
          <span class="element-motion__play" aria-hidden="true"></span>
        </button>
      </article>
    ))}
  </div>

  <article
    class="element-panel"
    id="element-panel"
    role="tabpanel"
    aria-labelledby={`element-tab-${initialElement.key}`}
    aria-live="polite"
  >
    <header class="element-panel__header">
      <p class="element-panel__number" data-panel-number>{initialElement.number}</p>
      <div class="element-panel__intro">
        <p class="element-panel__subtitle" data-panel-subtitle>{initialElement.subtitle}</p>
        <h3 data-panel-title>{initialElement.title}</h3>
        <p class="element-panel__summary" data-panel-summary>{initialElement.summary}</p>
        <p class="element-panel__introduction" data-panel-introduction>{initialElement.introduction}</p>
      </div>
      <ul class="element-panel__traits" aria-label={`Качества стихии ${initialElement.name}`} data-panel-traits>
        {initialElement.traits.map((trait) => <li>{trait}</li>)}
      </ul>
    </header>

    <div class="element-panel__details">
      <section class="element-panel__section">
        <p class="element-panel__label">В гармонии <span>(плюсы)</span></p>
        <div class="element-panel__paragraphs" data-panel-harmony>
          {initialElement.harmony.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="element-panel__section">
        <p class="element-panel__label">В дисбалансе <span>(минусы)</span></p>
        <div class="element-panel__paragraphs" data-panel-imbalance>
          {initialElement.imbalance.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    </div>

    <div class="element-panel__archetypes">
      <p class="element-panel__label">Архетипы в поведении</p>
      <p data-panel-archetypes>{initialElement.archetypes}</p>
    </div>
  </article>
</div>

<script define:vars={{ elements }}>
  const root = document.querySelector('[data-elements-root]');

  if (root) {
    const tabs = [...root.querySelectorAll('[data-element-tab]')];
    const cards = [...root.querySelectorAll('[data-element-card]')];
    const motionButtons = [...root.querySelectorAll('[data-element-motion]')];
    const panel = root.querySelector('#element-panel');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const setText = (selector, value) => {
      const target = root.querySelector(selector);
      if (target) target.textContent = value;
    };

    const createParagraphs = (paragraphs) => paragraphs.map((text) => {
      const paragraph = document.createElement('p');
      paragraph.textContent = text;
      return paragraph;
    });

    const updatePanel = (element) => {
      panel.setAttribute('aria-labelledby', `element-tab-${element.key}`);
      setText('[data-panel-number]', element.number);
      setText('[data-panel-subtitle]', element.subtitle);
      setText('[data-panel-title]', element.title);
      setText('[data-panel-summary]', element.summary);
      setText('[data-panel-introduction]', element.introduction);
      setText('[data-panel-archetypes]', element.archetypes);

      const traitList = root.querySelector('[data-panel-traits]');
      traitList.setAttribute('aria-label', `Качества стихии ${element.name}`);
      traitList.replaceChildren(...element.traits.map((trait) => {
        const item = document.createElement('li');
        item.textContent = trait;
        return item;
      }));

      root.querySelector('[data-panel-harmony]').replaceChildren(...createParagraphs(element.harmony));
      root.querySelector('[data-panel-imbalance]').replaceChildren(...createParagraphs(element.imbalance));
    };

    const selectElement = (key) => {
      const next = elements.find((element) => element.key === key);
      if (!next) return;

      tabs.forEach((tab) => {
        const selected = tab.dataset.elementTab === key;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      cards.forEach((card) => card.dataset.active = String(card.dataset.elementCard === key));

      panel.getAnimations().forEach((animation) => animation.cancel());
      if (!reducedMotion.matches && panel.animate) {
        const fade = panel.animate([{ opacity: 1 }, { opacity: 0.42 }], { duration: 90, easing: 'ease-out' });
        fade.finished.then(() => {
          updatePanel(next);
          panel.animate([{ opacity: 0.42 }, { opacity: 1 }], { duration: 190, easing: 'ease-out' });
        });
      } else {
        updatePanel(next);
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectElement(tab.dataset.elementTab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        tabs[nextIndex].focus();
        selectElement(tabs[nextIndex].dataset.elementTab);
      });
    });

    const setCardMotion = (card, button, enabled) => {
      const elementName = card.dataset.elementName;
      card.dataset.motion = enabled ? 'on' : 'off';
      button.setAttribute('aria-pressed', String(enabled));
      button.setAttribute('aria-label', `${enabled ? 'Остановить' : 'Включить'} движение стихии ${elementName}`);
      button.title = `${enabled ? 'Остановить' : 'Включить'} движение стихии ${elementName}`;
    };

    motionButtons.forEach((button) => {
      const card = root.querySelector(`[data-element-card="${button.dataset.elementMotion}"]`);
      button.addEventListener('click', () => setCardMotion(card, button, card.dataset.motion !== 'on'));
    });

    if (reducedMotion.matches) {
      motionButtons.forEach((button) => {
        const card = root.querySelector(`[data-element-card="${button.dataset.elementMotion}"]`);
        setCardMotion(card, button, false);
        button.disabled = true;
        button.title = 'Движение отключено системной настройкой';
      });
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        root.dataset.visible = String(entry.isIntersecting);
      }, { threshold: 0.12 });
      observer.observe(root);
    } else {
      root.dataset.visible = 'true';
    }
  }
</script>

<style>
  .elements-experience {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: linear-gradient(145deg, rgb(32 32 35 / 98%), rgb(14 14 16 / 99%));
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 16%);
  }

  .element-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
  }

  .element-card {
    position: relative;
    min-height: clamp(12.5rem, 20vw, 15.5rem);
    isolation: isolate;
    overflow: hidden;
    background: var(--color-black);
  }

  .element-card::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 1px solid transparent;
    content: '';
    pointer-events: none;
    transition: border-color 240ms ease, box-shadow 240ms ease;
  }

  .element-card[data-active='true']::after {
    border-color: var(--color-gold-muted);
    box-shadow: inset 0 0 0 1px rgb(181 154 101 / 12%);
  }

  .element-card__visual,
  .element-card__visual::before,
  .element-card__visual::after {
    position: absolute;
    inset: 0;
  }

  .element-card__visual::before {
    z-index: 1;
    content: '';
    opacity: 0.55;
    pointer-events: none;
  }

  .element-card__visual::after {
    z-index: 2;
    background: linear-gradient(180deg, rgb(9 9 10 / 18%), rgb(9 9 10 / 12%) 32%, rgb(9 9 10 / 90%) 100%);
    content: '';
    pointer-events: none;
  }

  .element-card__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
  }

  .element-card__select {
    position: absolute;
    inset: 0;
    display: flex;
    z-index: 2;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1rem;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    text-align: left;
  }

  .element-card__select:focus-visible { outline: 2px solid var(--color-gold); outline-offset: -0.45rem; }
  .element-card__number { color: rgb(238 231 220 / 76%); font-family: var(--font-display); font-size: 1.45rem; line-height: 1; text-shadow: 0 2px 0.8rem rgb(0 0 0 / 70%); }
  .element-card__copy { display: grid; gap: 0.35rem; max-width: 17rem; }
  .element-card__name { font-family: var(--font-display); font-size: clamp(1.55rem, 3vw, 2.15rem); line-height: 1; }
  .element-card__subtitle { color: var(--color-gold); font-size: 0.66rem; font-weight: 650; letter-spacing: 0.1em; line-height: 1.45; text-transform: uppercase; }
  .element-card__traits { color: rgb(238 231 220 / 68%); font-size: 0.68rem; line-height: 1.45; }

  .element-motion {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    width: 2rem;
    height: 2rem;
    z-index: 4;
    place-items: center;
    padding: 0;
    border: 1px solid rgb(238 231 220 / 28%);
    border-radius: 50%;
    background: rgb(9 9 10 / 52%);
    color: var(--color-gold);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 180ms ease, border-color 180ms ease;
  }

  .element-motion:hover { border-color: var(--color-gold); background: rgb(9 9 10 / 78%); }
  .element-motion__pause { width: 0.38rem; height: 0.55rem; border-inline: 1px solid currentColor; }
  .element-motion__play { display: none; width: 0; height: 0; margin-left: 0.1rem; border-block: 0.32rem solid transparent; border-left: 0.48rem solid currentColor; }
  [data-motion='off'] .element-motion__pause { display: none; }
  [data-motion='off'] .element-motion__play { display: block; }
  .element-motion:disabled { cursor: default; opacity: 0.62; }

  .element-panel { padding: clamp(1.4rem, 3.5vw, 2.75rem); }
  .element-panel__header { display: grid; align-items: start; gap: clamp(1rem, 2.5vw, 2rem); }
  .element-panel__number { color: var(--color-gold-muted); font-family: var(--font-display); font-size: clamp(2.8rem, 7vw, 5.25rem); line-height: 0.85; }
  .element-panel__subtitle { color: var(--color-gold); font-size: var(--text-xs); font-weight: 650; letter-spacing: 0.13em; line-height: 1.5; text-transform: uppercase; }
  .element-panel__intro h3 { max-width: 25ch; margin-top: 0.45rem; font-size: clamp(1.65rem, 3.2vw, 2.6rem); line-height: 1.12; }
  .element-panel__summary { max-width: 55rem; margin-top: 1rem; color: var(--color-text); font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.55; }
  .element-panel__introduction { max-width: 55rem; margin-top: 0.7rem; color: var(--color-muted); line-height: 1.65; }
  .element-panel__traits { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
  .element-panel__traits li { padding: 0.36rem 0.62rem; border: 1px solid var(--color-border); color: var(--color-muted); font-size: var(--text-xs); }

  .element-panel__details { display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: clamp(1.75rem, 4vw, 3rem); }
  .element-panel__section { padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
  .element-panel__label { color: var(--color-gold); font-size: var(--text-xs); font-weight: 650; letter-spacing: 0.13em; text-transform: uppercase; }
  .element-panel__label span { color: var(--color-gold-muted); font-weight: 400; }
  .element-panel__paragraphs { display: grid; gap: 0.75rem; margin-top: 0.9rem; color: var(--color-muted); font-size: 0.96rem; line-height: 1.62; }
  .element-panel__archetypes { display: grid; gap: 0.6rem; margin-top: clamp(1.5rem, 3vw, 2.25rem); padding-top: 1.15rem; border-top: 1px solid var(--color-border); }
  .element-panel__archetypes > p:last-child { font-family: var(--font-display); font-size: var(--text-lg); }

  [data-visible='true'] .element-card[data-motion='on'][data-element-card='earth'] :global(img) { animation: earth-live 7s ease-in-out infinite alternate; }
  [data-visible='true'] .element-card[data-motion='on'][data-element-card='earth'] .element-card__visual::before { background: radial-gradient(circle at 72% 24%, rgb(214 185 116 / 42%), transparent 34%); mix-blend-mode: screen; animation: earth-light 5.5s ease-in-out infinite alternate; }
  [data-visible='true'] .element-card[data-motion='on'][data-element-card='water'] :global(img) { animation: water-live 4.6s ease-in-out infinite alternate; }
  [data-visible='true'] .element-card[data-motion='on'][data-element-card='water'] .element-card__visual::before { background: linear-gradient(115deg, transparent 20%, rgb(238 199 113 / 28%) 48%, transparent 72%); mix-blend-mode: screen; animation: water-shimmer 3.2s ease-in-out infinite alternate; }
  [data-visible='true'] .element-card[data-motion='on'][data-element-card='fire'] :global(img) { animation: fire-live 2.35s ease-in-out infinite; }
  [data-visible='true'] .element-card[data-motion='on'][data-element-card='fire'] .element-card__visual::before { background: radial-gradient(circle at 50% 60%, rgb(255 153 42 / 42%), transparent 52%); mix-blend-mode: screen; animation: fire-glow 1.8s ease-in-out infinite alternate; }
  [data-visible='true'] .element-card[data-motion='on'][data-element-card='air'] :global(img) { animation: air-live 6.5s ease-in-out infinite alternate; }
  [data-visible='true'] .element-card[data-motion='on'][data-element-card='air'] .element-card__visual::before { background: linear-gradient(100deg, transparent 15%, rgb(238 231 220 / 22%) 46%, transparent 76%); mix-blend-mode: screen; animation: air-light 5s ease-in-out infinite alternate; }

  @keyframes earth-live { from { filter: brightness(0.88) saturate(0.9); transform: scale(1.08) translate3d(-0.6%, 0.4%, 0); } to { filter: brightness(1.1) saturate(1.02); transform: scale(1.15) translate3d(0.8%, -0.6%, 0); } }
  @keyframes earth-light { from { opacity: 0.28; transform: translate3d(-5%, 3%, 0) scale(0.94); } to { opacity: 0.88; transform: translate3d(5%, -3%, 0) scale(1.08); } }
  @keyframes water-live { from { filter: brightness(0.88) contrast(1.05); transform: scale(1.16) translate3d(-2.5%, 0.8%, 0); } to { filter: brightness(1.09) contrast(1.12); transform: scale(1.2) translate3d(2.5%, -0.8%, 0); } }
  @keyframes water-shimmer { from { opacity: 0.22; transform: translateX(-12%) skewX(-5deg); } to { opacity: 0.72; transform: translateX(12%) skewX(5deg); } }
  @keyframes fire-live { 0%, 100% { filter: brightness(0.9) saturate(0.92); transform: scale(1.08) translateY(0.8%); } 32% { filter: brightness(1.17) saturate(1.12); transform: scale(1.14) translateY(-1.4%); } 66% { filter: brightness(1.02) saturate(1.04); transform: scale(1.11) translate3d(0.8%, -0.5%, 0); } }
  @keyframes fire-glow { from { opacity: 0.26; transform: scale(0.9); } to { opacity: 0.86; transform: scale(1.14); } }
  @keyframes air-live { from { filter: brightness(0.9) contrast(0.96); transform: scale(1.14) translate3d(-2.8%, 0.6%, 0); } to { filter: brightness(1.1) contrast(1.04); transform: scale(1.2) translate3d(2.8%, -0.8%, 0); } }
  @keyframes air-light { from { opacity: 0.18; transform: translateX(-14%); } to { opacity: 0.62; transform: translateX(14%); } }

  @media (min-width: 58rem) {
    .element-panel__header { grid-template-columns: auto minmax(0, 1fr) minmax(10rem, 0.34fr); }
    .element-panel__details { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 63.99rem) {
    .element-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .element-card { min-height: 13rem; }
  }

  @media (max-width: 35rem) {
    .element-card { min-height: 11.75rem; }
    .element-card__select { padding: 0.75rem; }
    .element-card__number { font-size: 1.15rem; }
    .element-card__name { font-size: 1.45rem; }
    .element-card__subtitle { font-size: 0.58rem; letter-spacing: 0.07em; }
    .element-card__traits { display: none; }
    .element-motion { top: 0.55rem; right: 0.55rem; width: 1.8rem; height: 1.8rem; }
    .element-panel__number { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .element-card__visual :global(img), .element-card__visual::before { animation: none !important; transform: none !important; }
  }
</style>
