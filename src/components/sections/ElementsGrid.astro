---
import { Image } from 'astro:assets';
import earthImage from '../../assets/images/elements/earth.avif';
import waterImage from '../../assets/images/elements/water.avif';
import fireImage from '../../assets/images/elements/fire.avif';
import airImage from '../../assets/images/elements/air.avif';
import { elements } from '../../data/elements';

const images = { earth: earthImage, water: waterImage, fire: fireImage, air: airImage };
const initialElement = elements[0];
---

<div
  class="elements-experience"
  data-elements-root
  data-active-element={initialElement.key}
  data-expanded="false"
  data-motion="on"
  data-visible="false"
>
  <div class="elements-stage">
    <div class="elements-stage__visuals">
      {elements.map((element) => (
        <figure
          class="element-visual"
          data-element-visual={element.key}
          data-active={element.key === initialElement.key ? 'true' : 'false'}
          aria-hidden={element.key === initialElement.key ? 'false' : 'true'}
        >
          <Image
            src={images[element.key]}
            alt={element.imageAlt}
            widths={[640, 960, 1440]}
            sizes="(min-width: 78rem) 76rem, calc(100vw - 2rem)"
            format="webp"
            loading="lazy"
          />
        </figure>
      ))}
    </div>

    <div class="elements-stage__topbar">
      <div class="element-tabs" role="tablist" aria-label="Выберите стихию">
        {elements.map((element) => (
          <button
            class="element-tab"
            type="button"
            role="tab"
            id={`element-tab-${element.key}`}
            aria-controls="element-panel"
            aria-selected={element.key === initialElement.key ? 'true' : 'false'}
            tabindex={element.key === initialElement.key ? 0 : -1}
            data-element-tab={element.key}
          >
            <span>{element.number}</span>
            {element.name}
          </button>
        ))}
      </div>

      <button class="motion-toggle" type="button" aria-pressed="true" data-motion-toggle>
        <span class="motion-toggle__mark" aria-hidden="true"></span>
        <span data-motion-label>Движение включено</span>
      </button>
    </div>

    <article
      class="element-panel"
      id="element-panel"
      role="tabpanel"
      aria-labelledby={`element-tab-${initialElement.key}`}
      aria-live="polite"
    >
      <p class="element-panel__number" data-panel-number>{initialElement.number}</p>
      <div class="element-panel__copy">
        <p class="element-panel__subtitle" data-panel-subtitle>{initialElement.subtitle}</p>
        <h3 data-panel-name>{initialElement.name}</h3>
        <p class="element-panel__summary" data-panel-summary>{initialElement.summary}</p>
      </div>
      <div class="element-panel__actions">
        <ul class="element-panel__traits" aria-label={`Качества стихии ${initialElement.name}`} data-panel-traits>
          {initialElement.traits.map((trait) => <li>{trait}</li>)}
        </ul>
        <button
          class="details-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="element-insight"
          data-details-toggle
        >
          <span data-details-label>Смотреть глубже</span>
          <span class="details-toggle__mark" aria-hidden="true"></span>
        </button>
      </div>
    </article>
  </div>

  <div class="element-insight" id="element-insight" aria-hidden="true" data-element-insight>
    <div class="element-insight__inner">
      <div class="element-insight__item">
        <p>В гармонии</p>
        <span data-panel-harmony>{initialElement.harmony}</span>
      </div>
      <div class="element-insight__item">
        <p>В дисбалансе</p>
        <span data-panel-imbalance>{initialElement.imbalance}</span>
      </div>
      <div class="element-insight__item">
        <p>Архетипы</p>
        <span data-panel-archetypes>{initialElement.archetypes}</span>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ elements }}>
  const root = document.querySelector('[data-elements-root]');

  if (root) {
    const tabs = [...root.querySelectorAll('[data-element-tab]')];
    const visuals = [...root.querySelectorAll('[data-element-visual]')];
    const panel = root.querySelector('#element-panel');
    const insight = root.querySelector('[data-element-insight]');
    const detailsToggle = root.querySelector('[data-details-toggle]');
    const motionToggle = root.querySelector('[data-motion-toggle]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const setText = (selector, value) => {
      const target = root.querySelector(selector);
      if (target) target.textContent = value;
    };

    const updatePanel = (element) => {
      panel.setAttribute('aria-labelledby', `element-tab-${element.key}`);
      setText('[data-panel-number]', element.number);
      setText('[data-panel-name]', element.name);
      setText('[data-panel-subtitle]', element.subtitle);
      setText('[data-panel-summary]', element.summary);
      setText('[data-panel-harmony]', element.harmony);
      setText('[data-panel-imbalance]', element.imbalance);
      setText('[data-panel-archetypes]', element.archetypes);

      const traitList = root.querySelector('[data-panel-traits]');
      traitList.setAttribute('aria-label', `Качества стихии ${element.name}`);
      traitList.replaceChildren(...element.traits.map((trait) => {
        const item = document.createElement('li');
        item.textContent = trait;
        return item;
      }));
    };

    const selectElement = (key) => {
      const next = elements.find((element) => element.key === key);
      if (!next || root.dataset.activeElement === key) return;

      root.dataset.activeElement = key;
      tabs.forEach((tab) => {
        const selected = tab.dataset.elementTab === key;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      visuals.forEach((visual) => {
        const selected = visual.dataset.elementVisual === key;
        visual.dataset.active = String(selected);
        visual.setAttribute('aria-hidden', String(!selected));
      });

      panel.getAnimations().forEach((animation) => animation.cancel());
      if (!reducedMotion.matches && panel.animate) {
        const fade = panel.animate([{ opacity: 1 }, { opacity: 0.35 }], { duration: 90, easing: 'ease-out' });
        fade.finished.then(() => {
          updatePanel(next);
          panel.animate([{ opacity: 0.35 }, { opacity: 1 }], { duration: 180, easing: 'ease-out' });
        });
      } else {
        updatePanel(next);
      }
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectElement(tab.dataset.elementTab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = tabs.length - 1;
        tabs[nextIndex].focus();
        selectElement(tabs[nextIndex].dataset.elementTab);
      });
    });

    detailsToggle.addEventListener('click', () => {
      const expanded = root.dataset.expanded !== 'true';
      root.dataset.expanded = String(expanded);
      detailsToggle.setAttribute('aria-expanded', String(expanded));
      insight.setAttribute('aria-hidden', String(!expanded));
      setText('[data-details-label]', expanded ? 'Свернуть' : 'Смотреть глубже');
    });

    const setMotion = (enabled) => {
      root.dataset.motion = enabled ? 'on' : 'off';
      motionToggle.setAttribute('aria-pressed', String(enabled));
      setText('[data-motion-label]', enabled ? 'Движение включено' : 'Движение выключено');
    };

    motionToggle.addEventListener('click', () => setMotion(root.dataset.motion !== 'on'));

    if (reducedMotion.matches) {
      setMotion(false);
      motionToggle.disabled = true;
      setText('[data-motion-label]', 'Движение отключено системой');
    }

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        root.dataset.visible = String(entry.isIntersecting);
      }, { threshold: 0.15 });
      observer.observe(root);
    } else {
      root.dataset.visible = 'true';
    }
  }
</script>

<style>
  .elements-experience {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-black);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 18%);
  }

  .elements-stage {
    position: relative;
    display: flex;
    min-height: clamp(33rem, 54vw, 42rem);
    flex-direction: column;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  .elements-stage::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(9 9 10 / 66%) 0%, transparent 38%),
      linear-gradient(0deg, rgb(9 9 10 / 96%) 0%, rgb(9 9 10 / 58%) 42%, transparent 72%);
    content: '';
    pointer-events: none;
  }

  .elements-stage__visuals,
  .element-visual {
    position: absolute;
    inset: 0;
    z-index: -2;
    margin: 0;
  }

  .element-visual {
    opacity: 0;
    transition: opacity 520ms ease;
  }

  .element-visual[data-active='true'] { opacity: 1; }

  .element-visual::after {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 72% 32%, rgb(181 154 101 / 12%), transparent 34%);
    content: '';
    mix-blend-mode: screen;
    opacity: 0.55;
  }

  .element-visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    will-change: filter, transform;
  }

  .elements-stage__topbar {
    display: flex;
    z-index: 2;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .element-tabs {
    display: grid;
    width: min(100%, 43rem);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid rgb(238 231 220 / 18%);
    background: rgb(9 9 10 / 58%);
    backdrop-filter: blur(12px);
  }

  .element-tab {
    position: relative;
    display: grid;
    gap: 0.1rem;
    min-height: 3.8rem;
    place-content: center;
    padding: 0.55rem 0.75rem;
    border: 0;
    border-right: 1px solid rgb(238 231 220 / 12%);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1rem;
    text-align: center;
    transition: background 240ms ease, color 240ms ease;
  }

  .element-tab:last-child { border-right: 0; }
  .element-tab span { color: var(--color-gold-muted); font-family: var(--font-body); font-size: 0.62rem; letter-spacing: 0.12em; }
  .element-tab::after { position: absolute; right: 18%; bottom: -1px; left: 18%; height: 1px; transform: scaleX(0); background: var(--color-gold); content: ''; transition: transform 240ms ease; }
  .element-tab:hover { color: var(--color-text); }
  .element-tab[aria-selected='true'] { background: rgb(181 154 101 / 10%); color: var(--color-gold); }
  .element-tab[aria-selected='true']::after { transform: scaleX(1); }

  .motion-toggle {
    display: inline-flex;
    min-height: 3rem;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid rgb(238 231 220 / 18%);
    background: rgb(9 9 10 / 58%);
    color: var(--color-muted);
    cursor: pointer;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    backdrop-filter: blur(12px);
  }

  .motion-toggle__mark { width: 0.55rem; height: 0.55rem; border: 1px solid var(--color-gold); border-radius: 50%; box-shadow: 0 0 0 0.2rem rgb(181 154 101 / 8%); }
  [data-motion='off'] .motion-toggle__mark { border-radius: 0; box-shadow: none; transform: rotate(45deg); }
  .motion-toggle:disabled { cursor: default; opacity: 0.72; }

  .element-panel {
    display: grid;
    z-index: 2;
    align-items: end;
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: auto;
    padding: clamp(2rem, 6vw, 4.5rem) clamp(0.35rem, 2vw, 1.25rem) clamp(0.5rem, 1vw, 1rem);
  }

  .element-panel__number {
    color: var(--color-gold-muted);
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.78;
  }

  .element-panel__copy { max-width: 40rem; }
  .element-panel__copy h3 { margin-top: 0.35rem; font-size: clamp(2.4rem, 6vw, 5.25rem); }
  .element-panel__subtitle { color: var(--color-gold); font-size: var(--text-xs); font-weight: 650; letter-spacing: 0.13em; line-height: 1.5; text-transform: uppercase; }
  .element-panel__summary { max-width: 36rem; margin-top: 0.8rem; color: rgb(238 231 220 / 82%); font-family: var(--font-display); font-size: clamp(1rem, 1.4vw, 1.22rem); line-height: 1.55; }

  .element-panel__actions { display: grid; gap: 1rem; }
  .element-panel__traits { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
  .element-panel__traits li { padding: 0.35rem 0.58rem; border: 1px solid rgb(238 231 220 / 22%); background: rgb(9 9 10 / 28%); color: rgb(238 231 220 / 78%); font-size: var(--text-xs); backdrop-filter: blur(8px); }

  .details-toggle {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0;
    border: 0;
    border-top: 1px solid rgb(238 231 220 / 20%);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font-size: var(--text-sm);
  }

  .details-toggle__mark { position: relative; width: 0.9rem; height: 0.9rem; flex: 0 0 auto; }
  .details-toggle__mark::before, .details-toggle__mark::after { position: absolute; top: 50%; left: 0; width: 100%; height: 1px; background: var(--color-gold); content: ''; transition: transform 240ms ease; }
  .details-toggle__mark::after { transform: rotate(90deg); }
  [data-expanded='true'] .details-toggle__mark::after { transform: rotate(0); }

  .element-insight {
    display: grid;
    grid-template-rows: 0fr;
    border-top: 0 solid var(--color-border);
    background: linear-gradient(135deg, rgb(32 32 35 / 98%), rgb(20 20 22 / 98%));
    transition: grid-template-rows 320ms ease, border-top-width 320ms ease;
  }

  [data-expanded='true'] .element-insight { grid-template-rows: 1fr; border-top-width: 1px; }
  .element-insight__inner { display: grid; min-height: 0; overflow: hidden; }
  .element-insight__item { display: grid; align-content: start; gap: 0.65rem; padding: clamp(1.25rem, 3vw, 2rem); border-bottom: 1px solid var(--color-border); }
  .element-insight__item:last-child { border-bottom: 0; }
  .element-insight__item p { color: var(--color-gold); font-size: var(--text-xs); font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; }
  .element-insight__item span { color: var(--color-muted); line-height: 1.6; }

  [data-motion='on'][data-visible='true'] .element-visual[data-active='true'][data-element-visual='earth'] :global(img) { animation: earth-breathe 10s ease-in-out infinite alternate; }
  [data-motion='on'][data-visible='true'] .element-visual[data-active='true'][data-element-visual='earth']::after { animation: earth-light 8s ease-in-out infinite alternate; }
  [data-motion='on'][data-visible='true'] .element-visual[data-active='true'][data-element-visual='water'] :global(img) { animation: water-flow 8s ease-in-out infinite alternate; }
  [data-motion='on'][data-visible='true'] .element-visual[data-active='true'][data-element-visual='fire'] :global(img) { animation: fire-flicker 3.6s ease-in-out infinite alternate; }
  [data-motion='on'][data-visible='true'] .element-visual[data-active='true'][data-element-visual='air'] :global(img) { animation: air-drift 11s ease-in-out infinite alternate; }

  @keyframes earth-breathe { from { filter: brightness(0.9); transform: scale(1.02); } to { filter: brightness(1.04); transform: scale(1.045); } }
  @keyframes earth-light { from { opacity: 0.35; transform: translate3d(-2%, 1%, 0); } to { opacity: 0.72; transform: translate3d(2%, -1%, 0); } }
  @keyframes water-flow { from { filter: brightness(0.92); transform: scale(1.045) translate3d(-0.45%, 0, 0); } to { filter: brightness(1.04); transform: scale(1.055) translate3d(0.45%, -0.25%, 0); } }
  @keyframes fire-flicker { 0%, 100% { filter: brightness(0.92) saturate(0.92); transform: scale(1.025); } 46% { filter: brightness(1.09) saturate(1.04); transform: scale(1.045) translateY(-0.25%); } }
  @keyframes air-drift { from { filter: brightness(0.92); transform: scale(1.05) translate3d(-0.6%, 0, 0); } to { filter: brightness(1.04); transform: scale(1.065) translate3d(0.6%, -0.35%, 0); } }

  @media (min-width: 52rem) {
    .element-panel { grid-template-columns: auto minmax(0, 1fr) minmax(13rem, 0.5fr); }
    .element-insight__inner { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .element-insight__item { border-right: 1px solid var(--color-border); border-bottom: 0; }
    .element-insight__item:last-child { border-right: 0; }
  }

  @media (max-width: 51.99rem) {
    .elements-stage__topbar { display: grid; grid-template-columns: 1fr; justify-content: stretch; }
    .element-tabs { width: 100%; }
    .motion-toggle { justify-self: end; min-height: 2.4rem; }
    .element-panel { align-items: start; }
    .element-panel__number { display: none; }
  }

  @media (max-width: 35rem) {
    .elements-stage { min-height: 35rem; }
    .element-tabs { grid-template-columns: repeat(2, 1fr); }
    .element-tab:nth-child(2) { border-right: 0; }
    .element-tab:nth-child(-n + 2) { border-bottom: 1px solid rgb(238 231 220 / 12%); }
    .element-panel__copy h3 { font-size: clamp(2.4rem, 15vw, 4rem); }
    .motion-toggle span:last-child { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .element-visual, .element-insight, .details-toggle__mark::after { transition-duration: 0.01ms !important; }
    .element-visual :global(img), .element-visual::after { animation: none !important; transform: none !important; }
  }
</style>
