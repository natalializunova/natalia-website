---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-window-landscape.png';
import mirrorImage from '../assets/images/course/black-mirror-woman.png';
import authorPortrait from '../assets/images/home/author-portrait-v1.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import ContentCard from '../components/ui/ContentCard.astro';
import ElementsGrid from '../components/sections/ElementsGrid.astro';
import LivingHeroScene from '../components/sections/LivingHeroScene.astro';
import { products } from '../data/products';
import { services } from '../data/services';
import { site } from '../data/site';
---
<BaseLayout title={site.name} description={site.description} image={heroImage.src}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__visual">
        <LivingHeroScene />
      </div>
      <div class="hero__content">
        <h1>Вернись к своему внутреннему свету</h1>
        <p class="lead">Тысячи лет назад наши далекие предки обращались к Стихиям не просто как к природным явлениям, а как к первоосновам мироздания, поддерживаемым Божественными Силами. Магия Стихий была естественным продолжением жизни и используется по сей день.</p>
        <div class="button-row">
          <Button href="/courses/path-to-self/">О курсе</Button>
          <Button href="/about/" variant="ghost">Обо мне</Button>
        </div>
      </div>
    </div>
    <div class="hero__line" aria-hidden="true"></div>
  </section>

  <section class="section story-section philosophy-section">
    <div class="container">
      <div class="philosophy-shell__heading">
        <p class="eyebrow">О курсе</p>
      </div>
      <div class="philosophy-shell">
        <div class="philosophy-shell__visual">
          <Image src={mirrorImage} alt="Женщина всматривается в древнее чёрное зеркало" widths={[520, 760, 1040]} sizes="(min-width: 48rem) 44vw, 100vw" loading="lazy" />
        </div>
        <div class="stack philosophy-shell__copy">
          <p class="lead">Путь через четыре Стихии — это базовый метод. Он подсказывает, какой вектор выбрать, но пройти по нему необходимо самостоятельно.</p>
          <p class="muted">Используя мой Авторский курс, практики и символы, вы прикоснетесь к тайным знаниям, утерянным в эпохах веков.</p>
          <p class="muted">Этот путь требует осознанности, и здесь нет места времени. Только вы, настоящий момент и ваша истинная суть.</p>
          <div class="button-row"><Button href="/courses/path-to-self/" variant="ghost">Подробнее о курсе</Button></div>
          <blockquote class="philosophy-shell__quote">
            <p>Не искать готовый образ,<br />а вспоминать свой</p>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="section story-section section--surface elements-section">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div><p class="eyebrow">Четыре Стихии</p><h2>Четыре способа слышать себя</h2></div>
        <p class="lead elements-section__prompt">В каждом из нас от рождения заложены все четыре первоэлемента, но проявляются они у всех по-разному.</p>
      </div>
      <ElementsGrid />
    </div>
  </section>

  <section class="section story-section about-section">
    <div class="container split split--reverse about-section__grid">
      <div class="about-section__portrait"><Image src={authorPortrait} alt="Временный художественный портрет женщины в мистическом образе" widths={[520, 760, 1040]} sizes="(min-width: 64rem) 45vw, 100vw" loading="lazy" /></div>
      <div class="stack about-section__copy">
        <p class="eyebrow">Обо мне</p>
        <h2>Наталья Лизунова</h2>
        <p class="lead">Автор проекта «Ведьма во мне. Путь к себе».</p>
        <p class="muted">Личная история, образование, квалификации и профессиональный подход будут добавлены после согласования с автором. Мы намеренно не заменяем факты красивыми догадками.</p>
        <div class="button-row"><Button href="/about/" variant="ghost">Мой путь</Button></div>
      </div>
    </div>
  </section>

  <section class="section story-section section--surface services-section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Услуги и практики</p><h2>Пространство личной работы</h2><p class="lead">Ниже — редакционные заготовки будущих форматов, а не действующие коммерческие предложения.</p></div>
      <div class="grid grid--4">{services.map((item) => <ContentCard href={`/services/${item.slug}/`} title={item.title} summary={item.summary} image={item.image} imageAlt={item.imageAlt} meta={item.eyebrow} />)}</div>
      <div class="button-row"><Button href="/services/" variant="ghost">Весь каталог</Button></div>
    </div>
  </section>

  <section class="section story-section shop-section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Лавка артефактов</p><h2>Предметы с историей и смыслом</h2><p class="lead">Категории будущей лавки. Ассортимент, состав и условия продаж ещё не опубликованы.</p></div>
      <div class="grid grid--4">{products.map((item) => <ContentCard href={`/shop/${item.slug}/`} title={item.title} summary={item.summary} image={item.image} imageAlt={item.imageAlt} meta={item.category} />)}</div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero { position: relative; min-height: calc(100svh - 5.5rem); padding-block: var(--hero-top-space) clamp(4rem, 7vw, 6.5rem); overflow: hidden; background: radial-gradient(circle at 78% 35%, rgb(84 35 47 / 12%), transparent 34rem); }
  .hero__grid { display: grid; align-items: start; gap: 3rem; }
  .hero__content { position: relative; z-index: 2; order: -1; padding-top: clamp(0.25rem, 1vw, 0.9rem); }
  .hero h1 { max-width: 12ch; text-shadow: 0 0.8rem 2.8rem rgb(181 154 101 / 12%); }
  .hero .lead { max-width: 39rem; margin-top: 1.75rem; }
  .hero__visual { position: relative; }
  .hero__line { position: absolute; right: var(--page-gutter); bottom: 0; left: var(--page-gutter); height: 1px; background: linear-gradient(90deg, transparent, var(--color-gold-muted), transparent); opacity: 0.5; }
  .story-section { border: 0; }
  .story-section::before { position: absolute; top: -5rem; right: 0; left: 0; height: 10rem; background: linear-gradient(180deg, transparent, rgb(84 35 47 / 5%) 50%, transparent); content: ''; pointer-events: none; }
  .philosophy-section { background: radial-gradient(circle at 20% 46%, rgb(84 35 47 / 22%), transparent 31rem), linear-gradient(180deg, transparent, rgb(23 19 21 / 46%) 58%, transparent); }
  .philosophy-shell__heading { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .philosophy-shell { position: relative; display: grid; gap: clamp(2.5rem, 7vw, 7rem); align-items: stretch; }
  .philosophy-shell__visual { position: relative; min-height: clamp(23rem, 42vw, 36rem); overflow: hidden; border-radius: 48% 48% 1.25rem 1.25rem / 18% 18% 1.25rem 1.25rem; background: #050506; box-shadow: 0 2rem 5rem rgb(0 0 0 / 34%); }
  .philosophy-shell__visual :global(img) { width: 100%; height: 100%; min-height: inherit; object-fit: cover; object-position: center 40%; filter: saturate(0.76) brightness(0.72); }
  .philosophy-shell__visual::after { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(5 5 6 / 14%), transparent 42%, rgb(5 5 6 / 14%)); content: ''; pointer-events: none; }
  .philosophy-shell__copy { min-height: clamp(23rem, 42vw, 36rem); align-content: start; padding-top: clamp(0.25rem, 1.5vw, 1rem); }
  .philosophy-shell__copy .button-row { margin-top: 0.85rem; }
  .philosophy-shell__quote { position: relative; align-self: end; max-width: 27rem; margin: auto 0 0; padding: clamp(2rem, 5vw, 4rem) 0 0 clamp(2.75rem, 5vw, 4.75rem); border: 0; color: var(--color-sand); font-family: var(--font-display); font-size: clamp(1.25rem, 2.2vw, 1.85rem); font-style: italic; line-height: 1.45; }
  .philosophy-shell__quote::before { position: absolute; bottom: 0.78em; left: 0; width: clamp(1.75rem, 3.5vw, 3.5rem); height: 1px; background: linear-gradient(90deg, var(--color-gold-muted), transparent); content: ''; }
  .elements-section { background: radial-gradient(circle at 68% 38%, rgb(181 154 101 / 6%), transparent 34rem), linear-gradient(180deg, rgb(22 20 22 / 40%), rgb(29 27 28 / 70%) 42%, rgb(17 16 18 / 52%)); }
  .elements-section__prompt { max-width: 18rem; margin-left: auto; color: var(--color-sand); font-family: var(--font-display); font-style: italic; text-align: right; }
  .about-section { background: radial-gradient(circle at 84% 42%, rgb(84 35 47 / 18%), transparent 30rem); }
  .about-section__grid { align-items: start; }
  .about-section__portrait { min-height: clamp(30rem, 58vw, 43rem); overflow: hidden; border-radius: 48% 48% 1rem 1rem / 16% 16% 1rem 1rem; box-shadow: 0 2rem 5rem rgb(0 0 0 / 32%); }
  .about-section__portrait :global(img) { width: 100%; height: 100%; min-height: inherit; object-fit: cover; object-position: center 20%; }
  .about-section__copy { align-content: start; padding-top: 0.5rem; }
  .services-section { background: linear-gradient(180deg, rgb(20 18 20 / 48%), rgb(29 27 28 / 68%) 50%, rgb(18 17 19 / 48%)); }
  .shop-section { background: radial-gradient(circle at 18% 32%, rgb(84 35 47 / 14%), transparent 30rem); }
  @media (min-width: 54rem) {
    .hero__grid { grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr); gap: clamp(3rem, 6vw, 6rem); }
    .hero__content { order: 0; }
  }
  @media (min-width: 48rem) { .philosophy-shell { grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr); align-items: start; } }
  @media (max-width: 47.99rem) { .philosophy-shell__copy { min-height: auto; } .philosophy-shell__quote { margin-top: 1.5rem; padding-top: 1.5rem; } .elements-section__prompt { margin-left: 0; text-align: left; } }
</style>
