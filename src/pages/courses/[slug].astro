---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import { courses, type Course } from '../../data/courses';

export const getStaticPaths = (() => courses.map((course) => ({ params: { slug: course.slug }, props: { course } }))) satisfies GetStaticPaths;
const { course } = Astro.props as { course: Course };
---
<BaseLayout title={course.title} description={course.summary} image={course.image} noindex>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Курсы', href: '/courses/' }, { label: course.title }]} />
  <PageHero eyebrow={course.eyebrow} title={course.title} description={course.summary} />
  <section class="section course-story">
    <div class="narrow stack">
      <p class="eyebrow">О курсе</p>
      <h2>Авторский путь и практический опыт</h2>
      <div class="course-story__copy">{course.authorParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
      <div class="course-story__outcomes">
        <h3>Пройдя курс, вы научитесь:</h3>
        <ul>{course.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
      </div>
      <div class="course-story__closing">
        {course.closingParagraphs.map((paragraph, index) => <p class:list={{ 'course-story__signature': index === course.closingParagraphs.length - 1 }}>{paragraph}</p>)}
      </div>
      <div class="button-row"><Button href="/contact/">Записаться на курс</Button></div>
    </div>
  </section>
  <section class="section section--surface"><div class="container"><div class="section-heading"><p class="eyebrow">Структура</p><h2>Предварительные модули</h2></div><div class="grid grid--3">{course.modules.map((module, index) => <article class="card card__body"><p class="card__meta">Модуль {index + 1}</p><h3>{module.title}</h3><p>{module.description}</p></article>)}</div></div></section>
  <section class="section"><div class="container detail-grid"><div><p class="eyebrow">Для кого</p><h2>Предварительное описание</h2><ul class="muted">{course.audience.map((item) => <li>{item}</li>)}</ul></div><dl class="detail-list"><div><dt>Формат</dt><dd>{course.format}</dd></div><div><dt>Длительность</dt><dd>{course.duration}</dd></div><div><dt>Стоимость</dt><dd>{course.price}</dd></div><div><dt>Запись</dt><dd>Закрыта до утверждения программы</dd></div></dl></div></section>
  <section class="section section--surface"><div class="narrow"><div class="section-heading"><p class="eyebrow">Вопросы</p><h2>FAQ</h2></div>{course.faq.map((item) => <details class="faq"><summary>{item.question}</summary><div class="faq__answer">{item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{item.intro && <p>{item.intro}</p>}{item.practices && <ul>{item.practices.map((practice) => <li><strong>{practice.title}</strong> {practice.description}</li>)}</ul>}</div></details>)}<div class="button-row"><Button href="/contact/" variant="ghost">Контакты проекта</Button></div></div></section>
</BaseLayout>

<style>
  .course-story { background: radial-gradient(circle at 82% 15%, rgb(84 35 47 / 20%), transparent 30rem); }
  .course-story__copy { display: grid; gap: 1.15rem; color: var(--color-muted); line-height: 1.82; }
  .course-story__copy p { white-space: pre-line; }
  .course-story__outcomes { margin-top: 1rem; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid var(--color-border); background: rgb(9 9 10 / 46%); }
  .course-story__outcomes ul { display: grid; gap: 0.9rem; margin: 1.25rem 0 0; padding-left: 1.2rem; color: var(--color-text); line-height: 1.7; }
  .course-story__closing { display: grid; gap: 1rem; margin-top: 1rem; color: var(--color-muted); line-height: 1.8; }
  .course-story__closing p:nth-last-child(2) { color: var(--color-gold-bright); font-family: var(--font-display); font-size: var(--text-lg); }
  .course-story__signature { color: var(--color-sand); font-family: var(--font-display); font-size: var(--text-lg); font-style: italic; }
  .faq__answer { display: grid; gap: 1rem; padding-top: 1rem; color: var(--color-muted); line-height: 1.75; }
  .faq__answer ul { display: grid; gap: 1rem; margin: 0; padding-left: 1.15rem; }
  .faq__answer strong { color: var(--color-gold-bright); }
  .faq summary:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 0.3rem; }
</style>
