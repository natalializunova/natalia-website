---
import type { TraitGlyph } from '../../data/elements';

type Props = { name: TraitGlyph };
const { name } = Astro.props;
---

<svg class="trait-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'foundation' && <><path d="M12 3 19 8v8l-7 5-7-5V8Z"/><path d="M8 10h8M8 14h8"/></>}
  {name === 'measure' && <><rect x="5" y="5" width="14" height="14" rx="1"/><circle cx="12" cy="12" r="2.2"/><path d="M12 5v3M12 16v3M5 12h3M16 12h3"/></>}
  {name === 'sprout' && <><path d="M12 20v-8"/><path d="M12 14c-4.5 0-6.5-2.2-6.5-6 4.5 0 6.5 2.2 6.5 6ZM12 17c0-4.7 2.2-7 6.5-7 0 4.7-2.2 7-6.5 7Z"/></>}
  {name === 'empathy' && <><path d="M12 19c-4.8-2.7-7-5.4-7-8.2C5 8.6 6.5 7 8.6 7c1.4 0 2.6.7 3.4 1.9C12.8 7.7 14 7 15.4 7c2.1 0 3.6 1.6 3.6 3.8 0 2.8-2.2 5.5-7 8.2Z"/><path d="M9 11.5c.8-1.1 1.8-1.6 3-1.6"/></>}
  {name === 'intuition' && <><path d="M3.5 12s3.2-5 8.5-5 8.5 5 8.5 5-3.2 5-8.5 5-8.5-5-8.5-5Z"/><circle cx="12" cy="12" r="2.4"/><path d="M12 3v2M12 19v2"/></>}
  {name === 'sensitivity' && <><path d="M4 9c2.3 0 2.3-2 4.6-2s2.3 2 4.7 2 2.3-2 4.7-2"/><path d="M4 13c2.3 0 2.3-2 4.6-2s2.3 2 4.7 2 2.3-2 4.7-2"/><path d="M4 17c2.3 0 2.3-2 4.6-2s2.3 2 4.7 2 2.3-2 4.7-2"/></>}
  {name === 'charisma' && <><circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v3M12 18.2v3M2.8 12h3M18.2 12h3M5.5 5.5l2.1 2.1M16.4 16.4l2.1 2.1M18.5 5.5l-2.1 2.1M7.6 16.4l-2.1 2.1"/></>}
  {name === 'resolve' && <><path d="M5 19 19 5M11 5h8v8"/><path d="M5 13v6h6"/></>}
  {name === 'vitality' && <path d="M12 21c-4.1 0-7-2.7-7-6.5 0-3.2 2.1-5.7 5.4-9.7.1 3.2 1.7 4.6 2.9 5.8.7-1.5 1.7-2.7 3.1-3.9.5 3.3 2.6 4.8 2.6 7.8 0 3.8-2.9 6.5-7 6.5Z"/>}
  {name === 'intellect' && <><circle cx="12" cy="12" r="3"/><ellipse cx="12" cy="12" rx="9" ry="4.6"/><path d="M7.5 4.2c4.1 2.3 7.7 7.9 9 15.6"/></>}
  {name === 'freedom' && <><path d="M4 16c4-1 6.4-3.2 8.1-6.7 1.8-3.6 4-4.8 7.9-5.3-1.1 4.9-3.5 8-7.1 9.5C9.3 15 6.8 17.1 5 20"/><path d="M9 14.8 5.5 11M12.8 12.5 9 8.5M16.2 9.5 13.5 6"/></>}
  {name === 'curiosity' && <><path d="m12 3 1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3Z"/><circle cx="18.5" cy="18.5" r="1.5"/></>}
</svg>

<style>
  .trait-glyph {
    width: 0.78rem;
    height: 0.78rem;
    flex: 0 0 auto;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }
</style>
