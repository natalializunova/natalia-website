---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseOverview from '../../components/sections/CourseOverview.astro';
import { courses } from '../../data/courses';

const course = courses[0];
---
<BaseLayout title="О курсе" description="Авторская образовательная программа проекта Light Inside «Ведьма во мне»." noindex>
  <div id={course.slug}>
    <CourseOverview course={course} />
  </div>
</BaseLayout>
