---
interface Props {
  href: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  meta?: string;
}
const { href, title, summary, image, imageAlt, meta } = Astro.props;
---
<article class="card">
  <img class="card__image" src={image} alt={imageAlt} width="800" height="600" loading="lazy" decoding="async" />
  <div class="card__body">
    {meta && <p class="card__meta">{meta}</p>}
    <h3>{title}</h3>
    <p>{summary}</p>
    <a class="text-link" href={href}>Подробнее<span class="visually-hidden">: {title}</span></a>
  </div>
</article>
<style>.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }</style>
