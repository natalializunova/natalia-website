---
import forestImage from '../../assets/images/hero-forest-original-v1.png';
import frameImage from '../../assets/images/hero-portal-frame-transparent-v1.png';
---

<div class="hero-scene" data-motion="on">
  <div class="hero-scene__portal">
    <div class="hero-scene__view">
      <img
        src={forestImage.src}
        alt="Туманный лес, освещённый тёплым внутренним светом"
        width={forestImage.width}
        height={forestImage.height}
        loading="eager"
        fetchpriority="high"
      />
      <span class="hero-scene__forest-glow" aria-hidden="true"></span>
    </div>
    <img
      class="hero-scene__frame"
      src={frameImage.src}
      alt=""
      width={frameImage.width}
      height={frameImage.height}
      loading="eager"
      aria-hidden="true"
    />
    <span class="hero-scene__sun-glow" aria-hidden="true"></span>
  </div>
</div>

<style>
  .hero-scene { position: relative; width: min(100%, 46rem); margin-inline: auto; aspect-ratio: 1295 / 1215; }

  .hero-scene__portal {
    position: relative;
    width: 100%;
    height: 100%;
    isolation: isolate;
    filter: drop-shadow(0 2rem 2.8rem rgb(0 0 0 / 40%)) drop-shadow(0 0 2.4rem rgb(216 184 108 / 16%));
  }

  .hero-scene__view { position: absolute; top: 27.7%; right: 33.1%; bottom: 9.2%; left: 32.8%; z-index: 1; overflow: hidden; background: #071017; box-shadow: inset 0 0 2rem rgb(0 0 0 / 72%); }
  .hero-scene__view::after { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(6 12 19 / 4%), transparent 45%, rgb(3 5 7 / 24%)), radial-gradient(circle at 66% 40%, rgb(255 215 151 / 14%), transparent 40%); content: ''; pointer-events: none; }
  .hero-scene__view :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; filter: saturate(0.96) contrast(1.04) brightness(0.98); transform: scale(1.025); }
  .hero-scene :global(.hero-scene__frame) { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .hero-scene__forest-glow { position: absolute; top: 20%; right: 3%; z-index: 2; width: 62%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(255 226 171 / 32%), rgb(203 158 87 / 9%) 44%, transparent 72%); filter: blur(0.4rem); mix-blend-mode: screen; pointer-events: none; }
  .hero-scene__sun-glow { position: absolute; top: 7%; left: 39%; z-index: 4; width: 22%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(255 238 187 / 24%), rgb(216 184 108 / 7%) 45%, transparent 72%); filter: blur(0.3rem); mix-blend-mode: screen; pointer-events: none; }

  .hero-scene[data-motion='on'] .hero-scene__view :global(img) { animation: forest-breathe 16s ease-in-out infinite alternate; }
  .hero-scene[data-motion='on'] .hero-scene__forest-glow { animation: forest-light 8s ease-in-out infinite alternate; }
  .hero-scene[data-motion='on'] .hero-scene__sun-glow { animation: sun-breathe 7s ease-in-out infinite alternate; }

  @keyframes forest-breathe { from { transform: scale(1.025) translateY(0.2%); } to { transform: scale(1.055) translateY(-0.2%); } }
  @keyframes forest-light { from { opacity: 0.48; transform: scale(0.94); } to { opacity: 1; transform: scale(1.08); } }
  @keyframes sun-breathe { from { opacity: 0.48; transform: scale(0.92); } to { opacity: 1; transform: scale(1.12); } }

  @media (min-width: 96rem) {
    .hero-scene { width: auto; max-width: none; height: 100%; margin-right: 0; aspect-ratio: 1295 / 1215; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scene__view :global(img), .hero-scene__forest-glow, .hero-scene__sun-glow { animation: none !important; }
  }
</style>
