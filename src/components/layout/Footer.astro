---
import { navigation, site } from '../../data/site';
---

<footer class="site-footer">
  <div class="container site-footer__main">
    <div class="site-footer__intro">
      <div class="ornament" aria-hidden="true"><span></span></div>
      <p class="site-footer__name">{site.name}</p>
      <p>Авторское пространство Натальи Лизуновой. Содержание проекта находится в подготовке.</p>
    </div>
    <div>
      <h2>Разделы</h2>
      <ul>{navigation.slice(0, 4).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </div>
    <div>
      <h2>Продолжение</h2>
      <ul>{navigation.slice(4).map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </div>
    <div>
      <h2>Документы</h2>
      <ul>
        <li><a href="/privacy/">Конфиденциальность</a></li>
        <li><a href="/consent/">Согласие на обработку данных</a></li>
        <li><a href="/offer/">Публичная оферта</a></li>
      </ul>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <p>© {new Date().getFullYear()} {site.author}. Материалы сайта защищены.</p>
    <p>Версия 1.0 · Основа проекта</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); background: var(--color-black); }
  .site-footer__main { display: grid; gap: 2.5rem; padding-block: var(--space-7); }
  .site-footer__intro { max-width: 24rem; color: var(--color-muted); }
  .site-footer__name { margin: 1.5rem 0 0.75rem; color: var(--color-text); font-family: var(--font-display); font-size: 1.35rem; }
  h2 { margin-bottom: 1rem; color: var(--color-gold); font-family: var(--font-body); font-size: var(--text-xs); font-weight: 650; letter-spacing: 0.14em; text-transform: uppercase; }
  ul { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  a { color: var(--color-muted); font-size: var(--text-sm); text-decoration: none; }
  a:hover { color: var(--color-gold); }
  .site-footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; padding-block: 1.25rem; border-top: 1px solid var(--color-border); color: var(--color-muted); font-size: var(--text-xs); }
  @media (min-width: 42rem) { .site-footer__main { grid-template-columns: 1.7fr repeat(3, 1fr); } }
</style>
