---
import heroImage from '../assets/images/hero-arch.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import ContentCard from '../components/ui/ContentCard.astro';
import ElementsGrid from '../components/sections/ElementsGrid.astro';
import LivingHeroScene from '../components/sections/LivingHeroScene.astro';
import { courses } from '../data/courses';
import { products } from '../data/products';
import { services } from '../data/services';
import { site } from '../data/site';

const course = courses[0];
---
<BaseLayout title={site.name} description={site.description} image={heroImage.src}>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__visual">
        <LivingHeroScene />
      </div>
      <div class="hero__content">
        <h1>Повернись к своему внутреннему свету</h1>
        <p class="lead">Тысячи лет назад наши далекие предки обращались к Стихиям не просто как к природным явлениям, а как к первоосновам мироздания, поддерживаемым Божественными Силами. Магия Стихий была естественным продолжением жизни и используется по сей день.</p>
        <div class="button-row">
          <Button href="/courses/path-to-self/">О курсе</Button>
          <Button href="/about/" variant="ghost">Обо мне</Button>
        </div>
      </div>
    </div>
    <div class="hero__line" aria-hidden="true"></div>
  </section>

  <section class="section philosophy-section">
    <div class="container philosophy-shell">
      <div class="philosophy-shell__title">
        <p class="eyebrow">О курсе</p>
        <div class="philosophy-shell__mirror">
          <span aria-hidden="true"></span>
          <h2>Не искать готовый образ.<br />Вспоминать свой.</h2>
        </div>
      </div>
      <div class="stack philosophy-shell__copy">
        <p class="lead">Путь через четыре Стихии — это базовый метод. Он подсказывает, какой вектор выбрать, но пройти по нему необходимо самостоятельно.</p>
        <p class="muted">Используя мой Авторский курс, практики и символы, вы прикоснетесь к тайным знаниям, утерянным в эпохах веков.</p>
        <p class="muted">Этот путь требует осознанности, и здесь нет места времени. Только вы, настоящий момент и ваша истинная суть.</p>
        <div class="button-row"><Button href="/courses/path-to-self/" variant="ghost">Подробнее о курсе</Button></div>
      </div>
    </div>
  </section>

  <section class="section section--surface elements-section">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div><p class="eyebrow">Четыре Стихии</p><h2>Четыре способа слышать себя</h2></div>
        <p class="lead elements-section__prompt">Попробуй узнать себя</p>
      </div>
      <ElementsGrid />
    </div>
  </section>

  <section class="section">
    <div class="container split split--reverse">
      <div class="placeholder-frame"><img src="/images/placeholders/portrait.svg" alt="Место для будущего портрета Натальи Лизуновой" width="800" height="1000" loading="lazy" /></div>
      <div class="stack">
        <p class="eyebrow">Обо мне</p>
        <h2>Наталья Лизунова</h2>
        <p class="lead">Автор проекта «Ведьма во мне. Путь к себе».</p>
        <p class="muted">Личная история, образование, квалификации и профессиональный подход будут добавлены после согласования с автором. Мы намеренно не заменяем факты красивыми догадками.</p>
        <div class="button-row"><Button href="/about/" variant="ghost">Мой путь</Button></div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Услуги и практики</p><h2>Пространство личной работы</h2><p class="lead">Ниже — редакционные заготовки будущих форматов, а не действующие коммерческие предложения.</p></div>
      <div class="grid grid--3">{services.map((item) => <ContentCard href={`/services/${item.slug}/`} title={item.title} summary={item.summary} image={item.image} imageAlt={item.imageAlt} meta={item.eyebrow} />)}</div>
      <div class="button-row"><Button href="/services/" variant="ghost">Весь каталог</Button></div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="placeholder-frame"><img src={course.image} alt={course.imageAlt} width="800" height="1000" loading="lazy" /></div>
      <div class="stack">
        <p class="eyebrow">Основная программа</p>
        <h2>{course.title}</h2>
        <p class="lead">{course.summary}</p>
        <p class="notice">Программа находится в разработке. На сайте пока нет оплаты и сбора заявок.</p>
        <div class="button-row"><Button href={`/courses/${course.slug}/`}>Подробнее</Button></div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Лавка артефактов</p><h2>Предметы с историей и смыслом</h2><p class="lead">Категории будущей лавки. Ассортимент, состав и условия продаж ещё не опубликованы.</p></div>
      <div class="grid grid--4">{products.map((item) => <ContentCard href={`/shop/${item.slug}/`} title={item.title} summary={item.summary} image={item.image} imageAlt={item.imageAlt} meta={item.category} />)}</div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero { position: relative; min-height: calc(100svh - 4.75rem); padding-block: clamp(1.5rem, 4.5vw, 4.5rem) clamp(3rem, 6vw, 6rem); overflow: hidden; }
  .hero__grid { display: grid; width: min(calc(100% - 2rem), 90rem); align-items: center; gap: 3rem; }
  .hero__content { position: relative; z-index: 2; order: -1; }
  .hero h1 { max-width: 12ch; text-shadow: 0 0.8rem 2.8rem rgb(181 154 101 / 12%); }
  .hero .lead { max-width: 39rem; margin-top: 1.75rem; }
  .hero__visual { position: relative; }
  .hero__line { position: absolute; right: 4%; bottom: 0; left: 4%; height: 1px; background: linear-gradient(90deg, transparent, var(--color-gold-muted), transparent); }
  .philosophy-section { padding-block: clamp(4rem, 7vw, 7rem); background: radial-gradient(circle at 20% 46%, rgb(84 35 47 / 24%), transparent 31rem); }
  .philosophy-shell { position: relative; display: grid; gap: clamp(2.5rem, 7vw, 7rem); overflow: hidden; padding: clamp(2rem, 5vw, 4.5rem); border: 1px solid rgb(181 154 101 / 28%); background: linear-gradient(120deg, rgb(22 18 21 / 98%), rgb(13 13 15 / 96%)); box-shadow: inset 0 0 4rem rgb(84 35 47 / 17%), 0 2rem 5rem rgb(0 0 0 / 18%); }
  .philosophy-shell::before { position: absolute; inset: 0.8rem; border: 1px solid rgb(181 154 101 / 10%); content: ''; pointer-events: none; }
  .philosophy-shell::after { position: absolute; top: 0; bottom: 0; left: 48%; width: 1px; background: linear-gradient(transparent, rgb(181 154 101 / 30%), transparent); content: ''; opacity: 0.55; }
  .philosophy-shell__title, .philosophy-shell__copy { position: relative; z-index: 1; }
  .philosophy-shell__mirror { position: relative; display: grid; min-height: clamp(18rem, 32vw, 25rem); margin-top: 1.4rem; place-items: center; padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3.5rem); border: 1px solid rgb(216 184 108 / 46%); border-radius: 50% 50% 44% 44%; background: radial-gradient(ellipse at 55% 34%, rgb(149 90 67 / 17%), transparent 35%), linear-gradient(145deg, #141215, #020203 68%); box-shadow: inset 0 0 5rem rgb(0 0 0 / 86%), inset 0 0 1.2rem rgb(216 184 108 / 7%), 0 0 3rem rgb(84 35 47 / 18%); text-align: center; }
  .philosophy-shell__mirror::before, .philosophy-shell__mirror::after { position: absolute; border: 1px solid rgb(181 154 101 / 19%); border-radius: inherit; content: ''; }
  .philosophy-shell__mirror::before { inset: 0.55rem; box-shadow: inset 0 0 0 0.3rem rgb(5 5 6 / 80%); }
  .philosophy-shell__mirror::after { inset: 1.15rem; background: radial-gradient(circle at 62% 35%, rgb(238 231 220 / 7%), transparent 28%), linear-gradient(135deg, rgb(84 35 47 / 14%), rgb(2 2 3 / 78%)); }
  .philosophy-shell__mirror span { position: absolute; top: 1.5rem; width: 0.65rem; height: 0.65rem; z-index: 2; border: 1px solid var(--color-gold-muted); transform: rotate(45deg); }
  .philosophy-shell__mirror h2 { position: relative; z-index: 2; max-width: 13ch; color: var(--color-gold-bright); font-size: clamp(1.75rem, 3.8vw, 3.3rem); text-shadow: 0 0 1.8rem rgb(216 184 108 / 24%); }
  .philosophy-shell__copy { align-content: center; }
  .philosophy-shell__copy .button-row { margin-top: 0.85rem; }
  .elements-section { padding-block: clamp(4.5rem, 8vw, 7.5rem); }
  .elements-section__prompt { max-width: 18rem; margin-left: auto; color: var(--color-sand); font-family: var(--font-display); font-style: italic; text-align: right; }
  @media (min-width: 54rem) {
    .hero__grid { grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr); gap: clamp(4rem, 8vw, 9rem); }
    .hero__content { order: 0; }
  }
  @media (min-width: 48rem) { .philosophy-shell { grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); align-items: center; } }
  @media (max-width: 47.99rem) { .philosophy-shell::after { display: none; } .philosophy-shell__mirror { min-height: 19rem; margin-top: 1.5rem; } .elements-section__prompt { margin-left: 0; text-align: left; } }
</style>
